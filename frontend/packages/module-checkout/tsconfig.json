{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@magentofullstackdev/hyperion-shared": ["../shared/src/index.ts"],
            "@magentofullstackdev/hyperion-shared/*": ["../shared/src/*"]
        },
        "types": ["vite/client", "node"]
    },
    "include": ["src/**/*.ts", "index.html", "vite.config.ts", "vitest.config.ts", "tailwind.config.ts"],
    "exclude": ["node_modules", "dist"]
}
