{
    "name": "@magentofullstackdev/hyperion-checkout",
    "version": "0.9.0-beta.1",
    "description": "Hyperion one-step Magento 2 checkout: Lit + Tailwind, signal-based store, REST-driven. Replacement for the Luma Knockout/jQuery checkout.",
    "license": "MIT",
    "author": "Sergiu Ro <sergiu.ro@magentofullstack.dev>",
    "homepage": "https://hyperionfront.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magentofullstackdev/hyperion.git",
        "directory": "frontend/packages/module-checkout"
    },
    "bugs": {
        "url": "https://github.com/magentofullstackdev/hyperion/issues"
    },
    "keywords": [
        "magento",
        "magento2",
        "hyperion",
        "magento-checkout",
        "one-step-checkout",
        "lit",
        "tailwind",
        "signals",
        "frontend"
    ],
    "type": "module",
    "main": "./src/main.ts",
    "files": [
        "src",
        "tailwind.config.ts",
        "README.md",
        "LICENSE",
        "!src/**/__tests__",
        "!src/**/*.test.*",
        "!src/**/*.spec.*",
        "!src/fixtures",
        "!src/styles/dev-harness.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run i18n:sync && vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint 'src/**/*.{ts,js}'",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "clean": "rm -rf ../../../app/code/Magentofullstackdev/HyperionCheckout/view/frontend/web/assets ../../../app/code/Magentofullstackdev/HyperionCheckout/view/frontend/web/.vite",
        "i18n:sync": "node scripts/sync-i18n.mjs",
        "prepublishOnly": "npm run typecheck && npm run lint && npm run test"
    },
    "dependencies": {
        "@magentofullstackdev/hyperion-shared": "workspace:^",
        "@lit-labs/signals": "^0.1.0",
        "lit": "^3.1.2",
        "signal-polyfill": "^0.2.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.40.0",
        "@types/node": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "@vitest/coverage-v8": "^3.2.7",
        "autoprefixer": "^10.4.0",
        "eslint": "^8.56.0",
        "jsdom": "^30.1.3",
        "postcss": "^8.4.0",
        "rollup-plugin-license": "^3.7.1",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.0",
        "vite": "^6.4.5",
        "vitest": "^3.2.7"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
