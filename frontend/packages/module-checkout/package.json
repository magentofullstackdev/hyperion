{
    "name": "@magentofullstackdev/hyperion-checkout",
    "version": "0.9.0-beta.7",
    "description": "Hyperion one-step Magento 2 checkout: Lit + Tailwind, signal-based store, REST-driven. Replacement for the Luma Knockout/jQuery checkout.",
    "license": "MIT",
    "author": "Sergiu Ro <sergiu.ro@magentofullstack.dev>",
    "homepage": "https://hyperionfront.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magentofullstackdev/hyperion.git",
        "directory": "frontend/packages/module-checkout"
    },
    "bugs": {
        "url": "https://github.com/magentofullstackdev/hyperion/issues"
    },
    "keywords": [
        "magento",
        "magento2",
        "hyperion",
        "magento-checkout",
        "one-step-checkout",
        "lit",
        "tailwind",
        "signals",
        "frontend"
    ],
    "type": "module",
    "main": "./src/main.ts",
    "types": "./extension-api.d.ts",
    "exports": {
        ".": "./src/main.ts",
        "./extension-api": {
            "types": "./extension-api.d.ts"
        },
        "./testing": {
            "types": "./testing/index.d.ts",
            "default": "./testing/index.js"
        },
        "./testing/harness.html": "./testing/harness.html",
        "./fixtures/*.json": "./src/fixtures/*.json",
        "./src/*": "./src/*",
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "testing",
        "extension-api.d.ts",
        "tailwind.config.ts",
        "README.md",
        "LICENSE",
        "!src/**/__tests__",
        "!src/**/*.test.*",
        "!src/**/*.spec.*",
        "!src/fixtures/payment.braintree.json",
        "!src/styles/dev-harness.css",
        "!testing/__tests__",
        "!testing/tsconfig.json",
        "!testing/vitest.config.js"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite",
        "dev:harness": "vite --config testing/vite.config.js",
        "build": "npm run i18n:sync && vite build",
        "typecheck": "tsc --noEmit && tsc --noEmit -p testing/tsconfig.json",
        "lint": "eslint 'src/**/*.{ts,js}' 'testing/**/*.{js,ts}'",
        "test": "vitest run && vitest run --config testing/vitest.config.js",
        "test:kit": "vitest run --config testing/vitest.config.js",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "clean": "rm -rf ../../../app/code/Magentofullstackdev/HyperionCheckout/view/frontend/web/assets ../../../app/code/Magentofullstackdev/HyperionCheckout/view/frontend/web/.vite",
        "i18n:sync": "node scripts/sync-i18n.mjs",
        "budget": "node scripts/bundle-budget.mjs",
        "pack:check": "node scripts/check-pack.mjs",
        "prepublishOnly": "npm run typecheck && npm run lint && npm run test"
    },
    "dependencies": {
        "@lit-labs/signals": "^0.1.0",
        "@magentofullstackdev/hyperion-shared": "workspace:^",
        "lit": "^3.1.2",
        "signal-polyfill": "^0.2.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.40.0",
        "@types/node": "^22.0.0",
        "@vitest/coverage-v8": "^4.1.12",
        "autoprefixer": "^10.4.0",
        "eslint": "^10.14.0",
        "jsdom": "^30.1.3",
        "postcss": "^8.4.0",
        "rollup-plugin-license": "^3.7.1",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.0",
        "vite": "^6.4.5",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
