{
    "name": "@magentofullstackdev/hyperion-theme",
    "version": "0.9.0-beta.3",
    "description": "Hyperion default Magento 2 theme: TypeScript/Lit/Tailwind source. Replaces the Luma RequireJS/Knockout/jQuery stack with HTMX, Lit Web Components, and Tailwind.",
    "license": "MIT",
    "author": "Sergiu Ro <sergiu.ro@magentofullstack.dev>",
    "homepage": "https://hyperionfront.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magentofullstackdev/hyperion.git",
        "directory": "frontend/packages/theme-default"
    },
    "bugs": {
        "url": "https://github.com/magentofullstackdev/hyperion/issues"
    },
    "keywords": [
        "magento",
        "magento2",
        "hyperion",
        "magento-theme",
        "tailwind",
        "lit",
        "htmx",
        "vite",
        "frontend"
    ],
    "type": "module",
    "main": "./src/js/entry.js",
    "bin": {
        "hyperion": "bin/hyperion.js"
    },
    "files": [
        "bin",
        "src",
        "tailwind.config.ts",
        "README.md",
        "LICENSE",
        "!src/**/__tests__",
        "!src/**/*.test.*",
        "!src/**/*.spec.*"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite --port 5173",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf ../../../app/design/frontend/Magentofullstackdev/hyperion/web/assets ../../../app/design/frontend/Magentofullstackdev/hyperion/web/manifest.json",
        "lint": "eslint 'src/**/*.{js,ts}' bin/hyperion.js '../../build/**/*.ts'",
        "prepublishOnly": "npm run typecheck && npm run lint && npm run test"
    },
    "dependencies": {
        "@magentofullstackdev/hyperion-shared": "workspace:^",
        "htmx.org": "^2.0.8",
        "lit": "^3.1.2",
        "photoswipe": "^5.4.4"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.19",
        "@types/node": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "@vitest/coverage-v8": "^4.1.12",
        "autoprefixer": "^10.4.19",
        "eslint": "^8.56.0",
        "fast-check": "^3.23.2",
        "glob": "^14.0.3",
        "happy-dom": "^21.0.4",
        "postcss": "^8.4.38",
        "rollup-plugin-license": "^3.7.1",
        "tailwindcss": "^3.4.3",
        "typescript": "^5.3.0",
        "vite": "^6.4.5",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
