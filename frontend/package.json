{
    "name": "hyperion-frontend",
    "version": "0.0.0",
    "private": true,
    "description": "Centralized Frontend Workspace for the Hyperion Magento 2 suite. Builds JS/CSS into the matching Composer packages under app/design/... and app/code/... in this repo.",
    "workspaces": [
        "packages/shared",
        "packages/theme-default",
        "packages/module-checkout"
    ],
    "scripts": {
        "build": "pnpm -r build",
        "build:shared": "pnpm --filter @magentofullstackdev/hyperion-shared build",
        "build:theme": "pnpm --filter @magentofullstackdev/hyperion-theme build",
        "build:checkout": "pnpm --filter @magentofullstackdev/hyperion-checkout build",
        "dev:theme": "pnpm --filter @magentofullstackdev/hyperion-theme dev",
        "dev:checkout": "pnpm --filter @magentofullstackdev/hyperion-checkout dev",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "lint": "pnpm -r lint",
        "clean": "pnpm -r clean",
        "lint:e2e": "eslint 'e2e/**/*.mjs'",
        "e2e": "node e2e/pw-suite.mjs",
        "e2e:check": "node e2e/pw-check.mjs",
        "e2e:perf": "node e2e/pw-perf.mjs"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.40.0",
        "@tailwindcss/typography": "^0.5.19",
        "@types/node": "^22.0.0",
        "@vitest/coverage-v8": "^4.1.12",
        "autoprefixer": "^10.4.19",
        "axe-core": "^4.14.0",
        "eslint": "^10.14.0",
        "fast-check": "^3.23.2",
        "glob": "^14.0.3",
        "globals": "^17.14.0",
        "happy-dom": "^21.0.4",
        "jsdom": "^30.1.3",
        "postcss": "^8.4.38",
        "postcss-import": "^16.1.0",
        "rollup-plugin-license": "^3.7.1",
        "tailwindcss": "^3.4.3",
        "typescript": "^5.3.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^6.4.5",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "@lit-labs/signals": "^0.1.0",
        "htmx.org": "^2.0.8",
        "lit": "^3.1.2",
        "signal-polyfill": "^0.2.0"
    },
    "packageManager": "pnpm@10.33.2",
    "pnpm": {
        "overrides": {
            "source-map-js": ">=1.2.2",
            "postcss-selector-parser": "^6.1.5",
            "tinypool": ">=2.1.2",
            "minimatch@9": ">=9.0.9",
            "minimatch@10": ">=11.0.1"
        },
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
