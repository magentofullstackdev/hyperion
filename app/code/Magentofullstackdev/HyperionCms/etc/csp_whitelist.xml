<!--
    Hosts the PageBuilder storefront script (theme lib/pagebuilder.js) talks
    to. Magento_PageBuilder already allows the YouTube players; core loads
    Google Maps through its own RequireJS block, which Hyperion replaces with
    a lazy loader, and a keyless google.com embed when no API key is set.
-->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="frame-src">
            <values>
                <value id="hyperion_pb_google_maps_embed" type="host">www.google.com</value>
                <value id="hyperion_pb_vimeo_player" type="host">player.vimeo.com</value>
            </values>
        </policy>
        <policy id="script-src">
            <values>
                <value id="hyperion_pb_google_maps_api" type="host">maps.googleapis.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="hyperion_pb_google_maps_api" type="host">maps.googleapis.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="hyperion_pb_google_maps_api" type="host">maps.googleapis.com</value>
                <value id="hyperion_pb_google_maps_static" type="host">maps.gstatic.com</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="hyperion_pb_google_fonts" type="host">fonts.googleapis.com</value>
            </values>
        </policy>
        <policy id="font-src">
            <values>
                <value id="hyperion_pb_google_fonts_static" type="host">fonts.gstatic.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
