<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/topology.xsd">
    <!--
        Bind explicitly to the `magento-db` exchange on the `db`
        connection. Removed the previous `magento` exchange binding
        so a future `app/etc/env.php` AMQP entry can't silently
        reroute our messages - publisher, topology, and consumer
        are now all pinned to db.
    -->
    <exchange name="magento-db" type="topic" connection="db">
        <binding id="hyperionImageConvertBinding"
                 topic="hyperion.image.convert"
                 destinationType="queue"
                 destination="hyperion.image.convert"/>
    </exchange>
</config>
