<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="hyperion" translate="label" sortOrder="350">
            <label>Hyperion Theme</label>
        </tab>
        <section id="hyperion_image" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Images</label>
            <tab>hyperion</tab>
            <resource>Magentofullstackdev_HyperionImage::config</resource>

            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable WebP/AVIF generation</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="conversion_mode" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Conversion mode</label>
                    <source_model>Magentofullstackdev\HyperionImage\Model\Config\Source\ConversionMode</source_model>
                    <comment>
                        Queue (recommended): WebP/AVIF generated by cron consumer. JPG serves immediately as &lt;picture&gt; fallback.
                        Sync: WebP/AVIF generated synchronously when JPG cache is built. Use only if cron is not available. Adds 100-300ms per first image render.
                    </comment>
                </field>
                <field id="invalidate_on_batch_end" type="select" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Invalidate affected product pages after a batch</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        When enabled, the CLI bulk command and the queue consumer invalidate, once at the end of their run, the cache tags (cat_p_ID) of the products whose images were converted, so their cached pages re-render with the new &lt;source&gt; tags. Only those products are invalidated, the cache is never flushed as a whole. Images that belong to no product (category, wysiwyg) are picked up when the cached page expires. When disabled, every page picks up the new formats when its cache lifetime ends or when the product is saved.
                    </comment>
                </field>
                <field id="max_pixels" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Maximum source image size (pixels)</label>
                    <validate>validate-digits</validate>
                    <comment>Images above this many pixels (width x height) are not converted. 0 disables the limit.</comment>
                </field>
            </group>

            <group id="webp" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>WebP</label>
                <field id="enabled" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable WebP</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="quality" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>WebP quality (1-100)</label>
                    <validate>validate-digits validate-digits-range digits-range-1-100</validate>
                    <comment>Recommended: 80-85. Default: 82. Lower values produce smaller files but visible artefacts under 70.</comment>
                </field>
                <field id="skip_if_larger" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Skip if larger than original</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>For very small images, WebP can occasionally be larger than JPG. Enable to discard such cases.</comment>
                </field>
            </group>

            <group id="avif" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>AVIF</label>
                <field id="enabled" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable AVIF</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>AVIF produces ~30% smaller files than WebP but encoding is significantly slower (3-10x CPU). Recommended for static catalogs only.</comment>
                </field>
                <field id="quality" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>AVIF quality (1-100)</label>
                    <validate>validate-digits validate-digits-range digits-range-1-100</validate>
                </field>
                <field id="skip_if_larger" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Skip if larger than original</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="variants" translate="label" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Responsive variants</label>
                <field id="enabled" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Resized variants of content images</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Writes a WebP / AVIF file at each width below next to the full size companion of every image under media/wysiwyg (CMS pages, blocks, PageBuilder) and emits srcset and sizes on the picture sources, so phones download a banner cut to their width.</comment>
                </field>
                <field id="widths" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Variant widths (pixels)</label>
                    <comment>Comma separated, for example 640,960. A width is only generated when the source is wider.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <group id="encoder" translate="label" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Encoder</label>
                <field id="preference" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Encoder preference</label>
                    <source_model>Magentofullstackdev\HyperionImage\Model\Config\Source\Encoder</source_model>
                    <comment>Auto: prefers Imagick if installed, falls back to GD. Manual override for testing.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
