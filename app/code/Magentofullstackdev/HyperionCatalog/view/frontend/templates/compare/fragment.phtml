declare(strict_types=1);
/**
 * @var \Magentofullstackdev\HyperionCatalog\Block\Compare\Fragment $block
 * @var \Magento\Framework\Escaper $escaper
 */
$productIds = $block->getProductIds();
$items = $block->getItems();
$count = count($productIds) ?: $block->getItemCount();
// `data-hyperion-compare-ids` is the single source of truth the
// <hyperion-list-toggle kind="compare"> buttons read,
// `data-hyperion-compare-items` ({id, name, url} records) feeds
// <hyperion-compare-sidebar>; `oob` is set when this fragment ships inside
// an add / remove response.
?>
<a id="hyperion-compare-count"
   href="<?= $escaper->escapeUrl($block->getCompareUrl()) ?>"
   data-hyperion-compare-count
   data-hyperion-compare-ids="<?= $escaper->escapeHtmlAttr(implode(',', $productIds)) ?>"
   data-hyperion-compare-items="<?= $escaper->escapeHtmlAttr(json_encode($items, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)) ?>"
   <?php if ($block->getData('oob')): ?>hx-swap-oob="outerHTML"<?php endif; ?>
   class="relative hidden lg:inline-flex p-2 rounded-md text-muted hover:text-primary hover:bg-surface-raised
          focus:outline-none focus:ring-2 focus:ring-primary transition-colors"
   aria-label="<?= $escaper->escapeHtmlAttr(__('Compare (%1 items)', $count)) ?>">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
    </svg>
    <?php if ($count > 0): ?>
        <span class="absolute -top-1 -right-1 inline-flex items-center justify-center min-w-[1.125rem] px-1 py-0.5
                     text-[10px] leading-none font-bold rounded-full bg-primary text-on-primary"
              aria-hidden="true">
            <?= (int) $count ?>
        </span>
    <?php endif; ?>
</a>
