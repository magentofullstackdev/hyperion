<!--
    Fragment-only layout handle loaded by
    Magentofullstackdev\HyperionCheckout\Controller\Minicart\Fragment.

    The controller resolves `hyperion.minicart.fragment` directly via
    getBlock()->toHtml() and returns the result through RawFactory - no
    page chrome is rendered.  We only need the block tree assembled so the
    template can call $block->getCartData() via the CartData ViewModel.

    Cache note: this handle must remain cacheable=false at the controller
    level (set via the Response object); the ESI layer handles per-user
    caching at the Varnish edge.
-->
<!--
    cacheable="false" is mandatory. Without it the layout counts as
    cacheable and, on GET, Magento_PageCache's depersonalize plugins clear
    the customer session before the block renders: the checkout session
    then drops the customer's quote (customer_id mismatch) and a logged-in
    shopper sees an empty mini-cart and a badge of 0 after every reload,
    while the cart page (non-cacheable) still lists the items.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <block class="Magentofullstackdev\HyperionCheckout\Block\Minicart\Fragment"
               name="hyperion.minicart.fragment"
               cacheable="false"
               template="Magento_Checkout::minicart/fragment.phtml">
            <arguments>
                <argument name="cart_data_view_model"
                          xsi:type="object">Magentofullstackdev\HyperionCheckout\ViewModel\CartData</argument>
            </arguments>
        </block>
    </body>
</page>
