<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_failure">
        <observer name="hyperion_checkout_void_payment_on_submit_failure"
                  instance="Magentofullstackdev\HyperionCheckout\Observer\VoidPaymentOnSubmitFailureObserver"/>
    </event>
    <!-- Global scope: the order request is a REST call (webapi_rest area). -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="hyperion_checkout_add_order_comment"
                  instance="Magentofullstackdev\HyperionCheckout\Observer\AddOrderComment"/>
    </event>
    <event name="checkout_submit_all_after">
        <observer name="hyperion_checkout_subscribe_after_order"
                  instance="Magentofullstackdev\HyperionCheckout\Observer\SubscribeAfterOrder"/>
    </event>
</config>
