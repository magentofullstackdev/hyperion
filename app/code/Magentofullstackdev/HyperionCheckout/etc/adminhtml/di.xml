<!--
    Admin area DI of Magentofullstackdev_HyperionCheckout.

    The system message about active payment methods that the Hyperion checkout
    hides (no renderer serves them). Core declares
    `Magento\Framework\Notification\MessageList::$messages` in the admin area,
    so the item is added in this scope.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="hyperion_checkout_unsupported_payment_methods" xsi:type="string">Magentofullstackdev\HyperionCheckout\Model\System\Message\UnsupportedPaymentMethods</item>
            </argument>
        </arguments>
    </type>
</config>
