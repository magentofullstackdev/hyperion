{
    "name": "magentofullstackdev/module-hyperion-search",
    "description": "Hyperion Search: search engine powered autocomplete (products, categories, popular terms) cached at the edge, typo tolerance, SKU and promoted product boosting, stop words and a zero-results fallback",
    "type": "magento2-module",
    "license": "MIT",
    "version": "0.9.0-beta.2",
    "homepage": "https://hyperionfront.dev",
    "authors": [
        {
            "name": "Sergiu Ro",
            "email": "sergiu.ro@magentofullstack.dev",
            "homepage": "https://magentofullstack.dev",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/magentofullstackdev/hyperion/issues",
        "source": "https://github.com/magentofullstackdev/hyperion"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "magento/framework": "^103.0.6",
        "magento/module-catalog": "*",
        "magento/module-catalog-search": "*",
        "magento/module-search": "*",
        "magento/module-elasticsearch": "*",
        "magento/module-advanced-search": "*",
        "magento/module-store": "*",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magentofullstackdev/module-hyperion-core": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magentofullstackdev\\HyperionSearch\\": ""
        }
    }
}
