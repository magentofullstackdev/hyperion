<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <hyperion_search>
            <general>
                <fuzziness>auto</fuzziness>
                <fuzzy_min_query_length>4</fuzzy_min_query_length>
                <sku_boost>3</sku_boost>
                <promoted_skus></promoted_skus>
                <promoted_boost>100</promoted_boost>
                <stop_words></stop_words>
                <zero_results_fallback>1</zero_results_fallback>
            </general>
            <suggest>
                <products>4</products>
                <terms>4</terms>
                <categories>3</categories>
            </suggest>
        </hyperion_search>
    </default>
</config>
