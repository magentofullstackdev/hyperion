<!--
    GLOBAL on purpose. The `collections` argument of the UI component
    CollectionFactory is an array that core modules fill from their global
    di.xml files (customer_listing_data_source, sales_order_grid_data_source,
    ...). An area di.xml does not merge with that array: the object manager
    replaces a global argument with the area one as a whole
    (Magento\Framework\ObjectManager\Config\Config, array_replace on the
    argument names), so declaring this item under etc/adminhtml/ left the
    adminhtml area with ONE data source and every core grid that reads its
    collection through the factory failed with "Not registered handle
    customer_listing_data_source".
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Magentofullstackdev\HyperionMegaMenu\Model\ResourceModel\Group\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">hyperion_megamenu_group</argument>
            <argument name="resourceModel" xsi:type="string">Magentofullstackdev\HyperionMegaMenu\Model\ResourceModel\Group</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="hyperion_megamenu_group_listing_data_source" xsi:type="string">Magentofullstackdev\HyperionMegaMenu\Model\ResourceModel\Group\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
