declare(strict_types=1);
/**
 * "Recently Ordered" sidebar of the account pages (block `hyperion.reorder.sidebar`
 * in `hyperion.account.sidebar`, config `sales/reorder/allow`).
 *
 * Server rendered from the customer session: the account handles are private
 * and the block is uncacheable. The ticked order items post to
 * `checkout/cart/addgroup`, which adds them to the cart and redirects back.
 * Without purchase rights the list stays, as links, without the form controls.
 *
 * @var \Magentofullstackdev\HyperionCustomer\Block\Sidebar\Reorder $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magentofullstackdev\HyperionCore\Model\ViewModelRegistry $viewModels
 */
$items = $viewModels->require(\Magentofullstackdev\HyperionCustomer\ViewModel\SidebarWidgets::class)
    ->getReorderItems();
if (!$items) {
    return;
}
$canPurchase = $viewModels->require(\Magentofullstackdev\HyperionCore\ViewModel\Purchase::class)->canPurchase();
?>
<section class="bg-surface rounded-xl border border-subtle p-4 mb-6"
         aria-labelledby="hyperion-reorder-sidebar-heading"
         data-hyperion-reorder-sidebar>
    <h2 id="hyperion-reorder-sidebar-heading" class="text-base font-semibold text-secondary mb-2">
        <?= $escaper->escapeHtml(__('Recently Ordered')) ?>
    </h2>
    <?php if ($canPurchase): ?>
    <form method="post" action="<?= $escaper->escapeUrl($block->getFormActionUrl()) ?>">
        <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
    <?php endif; ?>
        <ol class="divide-y divide-subtle">
            <?php foreach ($items as $item): ?>
                <?php $inputId = 'hyperion-reorder-item-' . (int) $item['id']; ?>
                <li class="flex items-start gap-2 py-2 text-sm">
                    <?php if ($canPurchase): ?>
                        <input type="checkbox"
                               name="order_items[]"
                               id="<?= $escaper->escapeHtmlAttr($inputId) ?>"
                               value="<?= (int) $item['id'] ?>"
                               class="mt-0.5 h-4 w-4 shrink-0 rounded border-subtle text-primary
                                      focus:outline-none focus:ring-2 focus:ring-primary"
                               <?= $item['saleable'] ? '' : 'disabled' ?>>
                        <label for="<?= $escaper->escapeHtmlAttr($inputId) ?>"
                               class="min-w-0 flex-1 leading-snug text-secondary">
                            <?= $escaper->escapeHtml($item['name']) ?>
                            <?php if (!$item['saleable']): ?>
                                <span class="block text-xs text-muted"><?= $escaper->escapeHtml(__('Out of stock')) ?></span>
                            <?php endif; ?>
                        </label>
                    <?php else: ?>
                        <span class="min-w-0 flex-1 leading-snug text-secondary">
                            <?= $escaper->escapeHtml($item['name']) ?>
                        </span>
                    <?php endif; ?>
                    <?php if ($item['url'] !== ''): ?>
                        <a href="<?= $escaper->escapeUrl($item['url']) ?>"
                           class="shrink-0 text-xs font-medium text-primary hover:underline">
                            <?= $escaper->escapeHtml(__('View')) ?>
                            <span class="sr-only"><?= $escaper->escapeHtml($item['name']) ?></span>
                        </a>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ol>
    <?php if ($canPurchase): ?>
        <button type="submit"
                class="mt-3 inline-flex w-full items-center justify-center rounded-lg bg-primary px-3 py-2
                       text-sm font-semibold text-on-primary hover:bg-primary-hover
                       focus:outline-none focus:ring-2 focus:ring-primary"
                data-hyperion-reorder-sidebar-submit>
            <?= $escaper->escapeHtml(__('Add to Cart')) ?>
        </button>
    </form>
    <?php endif; ?>
    <a href="<?= $escaper->escapeUrl($block->getUrl('sales/order/history')) ?>"
       class="mt-3 inline-block text-sm font-medium text-primary hover:underline">
        <?= $escaper->escapeHtml(__('View All')) ?>
    </a>
</section>
