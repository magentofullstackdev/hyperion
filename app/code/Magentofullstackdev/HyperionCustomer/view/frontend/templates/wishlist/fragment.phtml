declare(strict_types=1);
/**
 * @var \Magentofullstackdev\HyperionCustomer\Block\Wishlist\Fragment $block
 * @var \Magento\Framework\Escaper $escaper
 */
$itemMap = $block->getItemMap();
$summaries = $block->getItemSummaries();
$count = count($itemMap) ?: $block->getItemCount();
$isLoggedIn = $block->isLoggedIn();
$targetUrl = $isLoggedIn ? $block->getWishlistUrl() : $block->getLoginUrl();
// `data-hyperion-wishlist-items` ({"productId": wishlistItemId, ...}) is the
// single source of truth the <hyperion-list-toggle kind="wishlist"> buttons
// read; `data-hyperion-wishlist-summary` (the newest items as product records)
// feeds <hyperion-wishlist-sidebar>; `oob` is set when this fragment ships
// inside an add / remove response.
?>
<a id="hyperion-wishlist-count"
   href="<?= $escaper->escapeUrl($targetUrl) ?>"
   data-hyperion-wishlist-count
   data-hyperion-wishlist-items="<?= $escaper->escapeHtmlAttr(json_encode($itemMap, JSON_FORCE_OBJECT)) ?>"
   data-hyperion-wishlist-summary="<?= $escaper->escapeHtmlAttr(json_encode($summaries, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)) ?>"
   <?php if ($block->getData('oob')): ?>hx-swap-oob="outerHTML"<?php endif; ?>
   class="relative hidden lg:inline-flex p-2 rounded-md text-muted hover:text-primary hover:bg-surface-raised
          focus:outline-none focus:ring-2 focus:ring-primary transition-colors"
   aria-label="<?= $escaper->escapeHtmlAttr(__('Wishlist (%1 items)', $count)) ?>">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
    </svg>
    <?php if ($count > 0): ?>
        <span class="absolute -top-1 -right-1 inline-flex items-center justify-center min-w-[1.125rem] px-1 py-0.5
                     text-[10px] leading-none font-bold rounded-full bg-primary text-on-primary"
              aria-hidden="true">
            <?= (int) $count ?>
        </span>
    <?php endif; ?>
</a>
