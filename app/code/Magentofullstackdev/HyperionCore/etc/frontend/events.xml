<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="controller_action_predispatch_checkout_index_index">
        <observer name="hyperion_core_checkout_empty_cart_redirect"
                  instance="Magentofullstackdev\HyperionCore\Observer\CheckoutEmptyCartRedirect"/>
    </event>
    <event name="layout_generate_blocks_after">
        <observer name="hyperion_core_populate_breadcrumbs"
                  instance="Magentofullstackdev\HyperionCore\Observer\PopulateBreadcrumbs"/>
    </event>
</config>
