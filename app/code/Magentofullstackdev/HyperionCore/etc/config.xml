<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <hyperion>
            <footer>
                <terms_cms_identifier>terms-and-conditions</terms_cms_identifier>
                <privacy_cms_identifier>privacy-policy-cookie-restriction-mode</privacy_cms_identifier>
            </footer>
            <catalog>
                <add_to_cart_from_listing>1</add_to_cart_from_listing>
            </catalog>
            <seo>
                <meta_description_fallback>1</meta_description_fallback>
            </seo>
            <security>
                <rate_limit_enabled>1</rate_limit_enabled>
                <search_suggest_limit>30</search_suggest_limit>
                <catalog_filter_limit>25</catalog_filter_limit>
                <trusted_proxies></trusted_proxies>
            </security>
        </hyperion>
        <dev>
            <!--
                The Vite build output (hashed files under an assets/ directory of the theme,
                the checkout module or a child theme) is already minified and its chunks import
                each other by file name: Magento's minification must neither rewrite nor rename
                them (no ".min" sign). Each value is a regular expression matched against the
                published file path.
            -->
            <js>
                <minify_exclude>
                    <hyperion_build>/assets/[^/]+[.-][A-Za-z0-9_-]{8}\.js$</hyperion_build>
                </minify_exclude>
            </js>
            <css>
                <minify_exclude>
                    <hyperion_build>/assets/[^/]+[.-][A-Za-z0-9_-]{8}\.css$</hyperion_build>
                </minify_exclude>
            </css>
        </dev>
        <catalog>
            <navigation>
                <max_depth>4</max_depth>
            </navigation>
        </catalog>
    </default>
</config>
