<!--
    Account dashboard: the Recently Viewed Products widget at the end of the
    content column, after the recent orders card. It renders from the
    browser history (localStorage, <hyperion-recently-viewed>), stays hidden
    and takes no space while that history is empty. Remove the block with
    <referenceBlock name="hyperion.dashboard.recently_viewed" remove="true"/>.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="hyperion.dashboard.recently_viewed"
                   template="Magento_Catalog::product/widget/history.phtml"
                   after="customer_account_dashboard_top">
                <arguments>
                    <argument name="hyperion_history_kind" xsi:type="string">viewed</argument>
                    <argument name="hyperion_history_mode" xsi:type="string">grid</argument>
                    <argument name="page_size" xsi:type="number">4</argument>
                    <argument name="show_attributes" xsi:type="string">name,image,price</argument>
                    <argument name="show_buttons" xsi:type="string">add_to_cart</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
