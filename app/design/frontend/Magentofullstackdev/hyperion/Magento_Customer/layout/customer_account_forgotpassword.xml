<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Forgot Your Password?</title>
    </head>
    <body>
        <!-- Remove default sidebar and Luma-specific blocks -->
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="require-cookie" remove="true"/>

        <!-- Reference (never re-declare) the core block: a re-declaration
             replaces the children Magento_Customer and Magento_ReCaptchaCustomer
             scheduled inside it (`form.additional.info` with the reCAPTCHA). -->
        <referenceBlock name="forgotPassword" template="Magento_Customer::form/forgotpassword.phtml">
            <container name="customer.form.forgotpassword.fields.before" as="form_fields_before"/>
        </referenceBlock>
    </body>
</page>
