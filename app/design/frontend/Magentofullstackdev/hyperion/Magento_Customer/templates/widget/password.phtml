/**
 * Hyperion password input with a show / hide toggle button.
 *
 * Shared by the login, register, account edit and reset password forms:
 *
 *   $block->getLayout()
 *       ->createBlock(\Magento\Framework\View\Element\Template::class)
 *       ->setTemplate('Magento_Customer::widget/password.phtml')
 *       ->setData([...])
 *       ->toHtml()
 *
 * Block data: field_id and field_name (required), autocomplete, required
 * (bool), minlength (int), described_by (id for aria-describedby) and
 * attributes (extra attribute => value pairs for the input). The click
 * behaviour lives in Magento_Customer::widget/password-toggle-js.phtml, which
 * every form that uses this field renders once.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
$fieldId = (string) $block->getData('field_id');
$minLength = (int) $block->getData('minlength');
$describedBy = (string) $block->getData('described_by');
$attributes = (array) $block->getData('attributes');
?>
<div class="relative">
    <input type="password"
           id="<?= $escaper->escapeHtmlAttr($fieldId) ?>"
           name="<?= $escaper->escapeHtmlAttr((string) $block->getData('field_name')) ?>"
           autocomplete="<?= $escaper->escapeHtmlAttr((string) ($block->getData('autocomplete') ?: 'off')) ?>"
           <?php if ($minLength > 0): ?>minlength="<?= (int) $minLength ?>"<?php endif; ?>
           <?php if ($describedBy !== ''): ?>aria-describedby="<?= $escaper->escapeHtmlAttr($describedBy) ?>"<?php endif; ?>
           <?php foreach ($attributes as $attribute => $attributeValue): ?>
               <?= $escaper->escapeHtmlAttr((string) $attribute) ?>="<?= $escaper->escapeHtmlAttr((string) $attributeValue) ?>"
           <?php endforeach; ?>
           class="w-full pl-4 pr-11 py-2.5 border border-subtle rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none"
           <?= $block->getData('required') ? 'required' : '' ?>/>
    <button type="button"
            class="absolute top-0 bottom-0 right-0 flex items-center px-3 text-muted hover:text-primary transition-colors rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
            data-hyperion-password-toggle
            aria-controls="<?= $escaper->escapeHtmlAttr($fieldId) ?>"
            aria-pressed="false"
            aria-label="<?= $escaper->escapeHtmlAttr(__('Show Password')) ?>">
        <span data-hyperion-password-icon="show">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                 aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>
        </span>
        <span data-hyperion-password-icon="hide" hidden>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                 aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M17.94 17.94A10.94 10.94 0 0112 19C5 19 1 12 1 12a20.3 20.3 0 015.06-5.94M9.9 4.24A10.4 10.4 0 0112 4c7 0 11 8 11 8a20.3 20.3 0 01-2.16 3.19M14.12 14.12a3 3 0 11-4.24-4.24M1 1l22 22"/>
            </svg>
        </span>
    </button>
</div>
