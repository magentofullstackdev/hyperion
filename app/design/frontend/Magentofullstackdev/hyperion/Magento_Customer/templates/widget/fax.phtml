/**
 * Hyperion styled fax widget.
 *
 * @var \Magento\Customer\Block\Widget\Fax $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<div>
    <label class="block text-sm font-medium text-secondary mb-1" for="fax">
        <?= $escaper->escapeHtml(__('Fax')) ?>
        <?php if ($block->isRequired()): ?>
            <span class="text-error" aria-hidden="true">*</span>
        <?php endif; ?>
    </label>
    <input type="tel"
           id="fax"
           name="fax"
           value="<?= $escaper->escapeHtmlAttr((string) $block->getFax()) ?>"
           class="w-full px-4 py-2.5 border border-subtle rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none"
           autocomplete="tel"
           <?= $block->isRequired() ? 'required' : '' ?>/>
</div>
