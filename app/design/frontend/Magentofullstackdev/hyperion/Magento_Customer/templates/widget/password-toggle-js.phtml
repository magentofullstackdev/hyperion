/**
 * Behaviour for the buttons rendered by Magento_Customer::widget/password.phtml.
 *
 * One delegated listener per page, so it covers any number of password fields
 * and markup swapped in later by HTMX. aria-pressed carries the state; fields
 * go back to type="password" before the form is submitted.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */
$script = <<<'JS'
(function () {
    if (window.hyperionPasswordToggle) { return; }
    window.hyperionPasswordToggle = true;

    function setVisible(button, visible) {
        var field = document.getElementById(button.getAttribute('aria-controls'));
        if (!field) { return; }
        field.type = visible ? 'text' : 'password';
        button.setAttribute('aria-pressed', visible ? 'true' : 'false');
        button.querySelectorAll('[data-hyperion-password-icon]').forEach(function (icon) {
            icon.toggleAttribute('hidden', (icon.getAttribute('data-hyperion-password-icon') === 'hide') !== visible);
        });
    }

    document.addEventListener('click', function (event) {
        var button = event.target.closest('[data-hyperion-password-toggle]');
        if (button) {
            setVisible(button, button.getAttribute('aria-pressed') !== 'true');
        }
    });

    document.addEventListener('submit', function (event) {
        event.target.querySelectorAll('[data-hyperion-password-toggle][aria-pressed="true"]').forEach(function (button) {
            setVisible(button, false);
        });
    }, true);
})();
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', ['type' => 'text/javascript'], $script, false) ?>
