/**
 * Hyperion gender widget.
 *
 * @var \Magento\Customer\Block\Widget\Gender $block
 * @var \Magento\Framework\Escaper $escaper
 */
$fieldId = $block->getFieldId('gender');
$value = $block->getGender();
?>
<div>
    <label class="block text-sm font-medium text-secondary mb-1" for="<?= $escaper->escapeHtmlAttr($fieldId) ?>">
        <?= $escaper->escapeHtml($block->getStoreLabel('gender')) ?>
        <?php if ($block->isRequired()): ?>
            <span class="text-error" aria-hidden="true">*</span>
        <?php endif; ?>
    </label>
    <select id="<?= $escaper->escapeHtmlAttr($fieldId) ?>"
            name="<?= $escaper->escapeHtmlAttr($block->getFieldName('gender')) ?>"
            autocomplete="sex"
            class="w-full px-4 py-2.5 border border-subtle rounded-lg bg-surface focus:ring-2 focus:ring-primary focus:border-primary outline-none"
            <?= $block->isRequired() ? 'required' : '' ?>>
        <?php foreach ($block->getGenderOptions() as $option): ?>
            <option value="<?= $escaper->escapeHtmlAttr($option->getValue()) ?>"
                <?= $option->getValue() == $value ? 'selected' : '' ?>>
                <?= $escaper->escapeHtml(__($option->getLabel())) ?>
            </option>
        <?php endforeach; ?>
    </select>
</div>
