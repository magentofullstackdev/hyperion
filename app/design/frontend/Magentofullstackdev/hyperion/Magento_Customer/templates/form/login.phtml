/**
 * Hyperion customer login form.
 *
 * @var \Magento\Customer\Block\Form\Login $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<div class="max-w-md mx-auto py-8">
    <div class="bg-surface rounded-2xl border border-subtle shadow-sm p-8">
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-secondary tracking-tight">
                <?= $escaper->escapeHtml(__('Sign In')) ?>
            </h1>
            <p class="mt-1 text-sm text-muted">
                <?= $escaper->escapeHtml(__('If you have an account, sign in with your email address.')) ?>
            </p>
        </div>

        <form class="space-y-5"
              action="<?= $escaper->escapeUrl($block->getPostActionUrl()) ?>"
              method="post"
              id="login-form">
            <?= $block->getBlockHtml('formkey') ?>

            <div>
                <label for="email" class="block text-sm font-medium text-secondary mb-1">
                    <?= $escaper->escapeHtml(__('Email')) ?>
                </label>
                <input type="email"
                       name="login[username]"
                       id="email"
                       value="<?= $escaper->escapeHtmlAttr($block->getUsername()) ?>"
                       required
                       autocomplete="username"
                       class="w-full px-4 py-2.5 border border-subtle rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none"/>
            </div>

            <div>
                <div class="flex items-center justify-between mb-1">
                    <label for="pass" class="block text-sm font-medium text-secondary">
                        <?= $escaper->escapeHtml(__('Password')) ?>
                    </label>
                    <a href="<?= $escaper->escapeUrl($block->getForgotPasswordUrl()) ?>"
                       class="text-xs text-primary hover:text-primary-hover hover:underline">
                        <?= $escaper->escapeHtml(__('Forgot Your Password?')) ?>
                    </a>
                </div>
                <?= $block->getLayout()
                    ->createBlock(\Magento\Framework\View\Element\Template::class)
                    ->setTemplate('Magento_Customer::widget/password.phtml')
                    ->setData([
                        'field_id' => 'pass',
                        'field_name' => 'login[password]',
                        'autocomplete' => 'current-password',
                        'required' => true,
                    ])
                    ->toHtml() ?>
            </div>

            <?= $block->getChildHtml('form_additional_info') ?>

            <button type="submit"
                    class="w-full py-3 px-6 bg-primary text-white font-bold rounded-lg hover:bg-primary-hover transition-colors shadow-md hover:shadow-lg text-sm uppercase tracking-wider">
                <?= $escaper->escapeHtml(__('Sign In')) ?>
            </button>
        </form>

        <div class="mt-6 pt-6 border-t border-subtle text-center text-sm text-muted">
            <?= $escaper->escapeHtml(__('New here?')) ?>
            <a href="<?= $escaper->escapeUrl($block->getUrl('customer/account/create')) ?>"
               class="ml-1 font-semibold text-primary hover:text-primary-hover hover:underline">
                <?= $escaper->escapeHtml(__('Create an Account')) ?>
            </a>
        </div>
    </div>
</div>
<?= $block->getLayout()
    ->createBlock(\Magento\Framework\View\Element\Template::class)
    ->setTemplate('Magento_Customer::widget/password-toggle-js.phtml')
    ->toHtml() ?>
