/**
 * Hyperion reset (create) password form.
 *
 * @var \Magento\Customer\Block\Account\Resetpassword $block
 * @var \Magentofullstackdev\HyperionCore\Model\ViewModelRegistry $viewModels
 * @var \Magento\Framework\Escaper $escaper
 */
$formKeyViewModel = $viewModels->require(\Magentofullstackdev\HyperionCore\ViewModel\FormKey::class);
$minimumPasswordLength = $block->getMinimumPasswordLength();
$passwordMinCharacterSets = $block->getRequiredCharacterClassesNumber();
$autocomplete = $block->isAutocompleteDisabled() ? 'off' : 'new-password';
?>
<div class="max-w-md mx-auto py-8">
    <div class="bg-surface rounded-2xl border border-subtle shadow-sm p-8">
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-secondary tracking-tight">
                <?= $escaper->escapeHtml(__('Set a New Password')) ?>
            </h1>
            <p class="mt-1 text-sm text-muted">
                <?= $escaper->escapeHtml(__('Please choose a new strong password for your account.')) ?>
            </p>
        </div>

        <form class="space-y-5"
              action="<?= $escaper->escapeUrl(
                  $block->getUrl(
                      '*/*/resetpasswordpost',
                      ['_query' => ['id' => $block->getRpCustomerId(), 'token' => $block->getResetPasswordLinkToken()]]
                  )
              ) ?>"
              method="post"
              id="form-validate">
            <input type="hidden"
                   name="form_key"
                   value="<?= $escaper->escapeHtmlAttr($formKeyViewModel->getFormKey()) ?>"/>

            <div>
                <label for="password" class="block text-sm font-medium text-secondary mb-1">
                    <?= $escaper->escapeHtml(__('New Password')) ?>
                </label>
                <?= $block->getLayout()
                    ->createBlock(\Magento\Framework\View\Element\Template::class)
                    ->setTemplate('Magento_Customer::widget/password.phtml')
                    ->setData([
                        'field_id' => 'password',
                        'field_name' => 'password',
                        'autocomplete' => $autocomplete,
                        'required' => true,
                        'minlength' => (int) $minimumPasswordLength,
                        'described_by' => 'password-strength-hint',
                        'attributes' => ['data-password-min-character-sets' => (int) $passwordMinCharacterSets],
                    ])
                    ->toHtml() ?>
                <p id="password-strength-hint" class="mt-1 text-xs text-muted">
                    <?= $escaper->escapeHtml(__('Minimum length: %1 characters.', $minimumPasswordLength)) ?>
                </p>
            </div>

            <div>
                <label for="password-confirmation" class="block text-sm font-medium text-secondary mb-1">
                    <?= $escaper->escapeHtml(__('Confirm New Password')) ?>
                </label>
                <?= $block->getLayout()
                    ->createBlock(\Magento\Framework\View\Element\Template::class)
                    ->setTemplate('Magento_Customer::widget/password.phtml')
                    ->setData([
                        'field_id' => 'password-confirmation',
                        'field_name' => 'password_confirmation',
                        'autocomplete' => $autocomplete,
                        'required' => true,
                    ])
                    ->toHtml() ?>
            </div>

            <button type="submit"
                    class="w-full py-3 px-6 bg-primary text-white font-bold rounded-lg hover:bg-primary-hover transition-colors shadow-md hover:shadow-lg text-sm uppercase tracking-wider">
                <?= $escaper->escapeHtml(__('Set a New Password')) ?>
            </button>
        </form>
    </div>
</div>
<?= $block->getLayout()
    ->createBlock(\Magento\Framework\View\Element\Template::class)
    ->setTemplate('Magento_Customer::widget/password-toggle-js.phtml')
    ->toHtml() ?>
