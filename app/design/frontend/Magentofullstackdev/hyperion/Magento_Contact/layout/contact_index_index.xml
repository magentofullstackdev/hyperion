<page layout="1column"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Contact Us</title>
    </head>
    <body>
        <!-- form.phtml renders the heading -->
        <referenceBlock name="page.main.title" remove="true"/>
        <!-- Reference (never re-declare) the core block: a re-declaration
             replaces the children Magento_Contact and Magento_ReCaptchaContact
             scheduled inside it (`form.additional.info` with the reCAPTCHA). -->
        <referenceBlock name="contactForm" template="Magento_Contact::form.phtml">
            <arguments>
                <argument name="formKeyViewModel" xsi:type="object">Magentofullstackdev\HyperionCore\ViewModel\FormKey</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
