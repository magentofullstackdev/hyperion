<!--
    The coupon_code reCAPTCHA on the Hyperion coupon form (hyperion_checkout_cart_fragment handle).

    Core mounts Magento\ReCaptchaUi\Block\ReCaptcha as a child of
    checkout.cart.coupon, a block the theme removes together with the
    Knockout cart tree (checkout_cart_index.xml of Magento_Checkout), so it
    never reached the Hyperion coupon block. This file, loaded only while
    Magento_ReCaptchaCheckoutSalesRule is enabled, adds the same block to
    hyperion.cart.coupon; cart/coupon.phtml renders the children inside a
    <template> that <hyperion-coupon-form> moves into its form. The same
    child is declared for both the page and the HTMX fragment handle so the
    answer of CouponPostPlugin carries it again. Keep the two files in sync.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="hyperion.cart.coupon">
            <block class="Magento\ReCaptchaUi\Block\ReCaptcha"
                   name="hyperion.cart.coupon.recaptcha"
                   as="recaptcha"
                   template="Magento_ReCaptchaFrontendUi::recaptcha.phtml"
                   ifconfig="recaptcha_frontend/type_for/coupon_code">
                <arguments>
                    <argument name="recaptcha_for" xsi:type="string">coupon_code</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
