/** @var \Magento\Framework\Escaper $escaper */
$shopLinks = $block->getShopLinks();
$privacyUrl = $block->getPrivacyPolicyUrl();
$termsUrl = $block->getTermsUrl();
$serviceLinks = $block->getServiceLinks();
$aboutHtml = $block->getAboutHtml();
$copyrightText = $block->getCopyrightText();
$homeUrl = $escaper->escapeUrl($block->getHomeUrl());
$logoUrl = $block->getLogoUrl();
$storeName = $block->getStoreName();
// Same accessible name as the header logo link: the image alt, or the label of the wordmark link.
$homeLabel = __('%1 Home', $storeName);
$logoAlt = $escaper->escapeHtmlAttr(__('%1 Home', $block->getLogoAlt()));
?>
<?php /* The id is the render blocking marker of the pages with an inline critical sheet
         (HyperionCore RenderBlockingMarkerPlugin, `<link rel="expect">`): the first paint waits
         until the parser has reached the footer. */ ?>
<footer id="hyperion-footer" role="contentinfo" class="bg-inverted text-on-inverted-muted mt-auto">

    <?php /* -- Main grid --------------------------------------- */ ?>
    <div class="container mx-auto px-4 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 pb-10 border-b border-subtle-inverted">

            <?php /* Brand -- same 3-step logo resolution as the header (admin upload ->
                   theme images/logo.svg -> the store's brand name as a wordmark), see
                   \Magentofullstackdev\HyperionNavigation\Model\LogoResolver. The paragraph
                   under it is the optional CMS block `hyperion-footer-about`. */ ?>
            <div>
                <a href="<?= /* @noEscape -- escaped above */ $homeUrl ?>"
                   <?php if ($logoUrl === ''): ?>
                       aria-label="<?= $escaper->escapeHtmlAttr($homeLabel) ?>"
                   <?php endif; ?>
                   class="inline-flex max-w-full items-center focus:outline-none focus:ring-2 focus:ring-primary rounded">
                    <?php if ($logoUrl !== ''): ?>
                        <img src="<?= $escaper->escapeUrl($logoUrl) ?>"
                             alt="<?= /* @noEscape -- escaped above */ $logoAlt ?>"
                             width="140" height="40"
                             class="h-10 w-auto object-contain"
                             loading="lazy" decoding="async">
                    <?php else: ?>
                        <?php /* A long brand name wraps, and a single long word breaks, inside the column. */ ?>
                        <span class="min-w-0 break-words text-2xl font-black tracking-tighter text-on-inverted
                                     hover:text-primary transition-colors">
                            <?= $escaper->escapeHtml($storeName) ?>
                        </span>
                    <?php endif; ?>
                </a>
                <?php if ($aboutHtml !== ''): ?>
                    <div data-hyperion-footer-about
                         class="mt-4 text-sm leading-relaxed text-on-inverted-muted">
                        <?= /* @noEscape -- CMS block content, already filtered */ $aboutHtml ?>
                    </div>
                <?php endif; ?>
            </div>

            <?php /* Shop column -- dynamic category links */ ?>
            <div>
                <h2 class="text-sm font-semibold uppercase tracking-wider text-on-inverted mb-4">
                    <?= $escaper->escapeHtml(__('Shop')) ?>
                </h2>
                <?php if (!empty($shopLinks)): ?>
                    <ul class="space-y-2 text-sm" role="list">
                        <?php foreach ($shopLinks as $link): ?>
                            <li>
                                <a href="<?= $escaper->escapeUrl($link['url']) ?>"
                                   class="text-on-inverted-muted hover:text-primary transition-colors
                                          focus:outline-none focus:ring-2 focus:ring-primary rounded">
                                    <?= $escaper->escapeHtml($link['name']) ?>
                                </a>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                <?php endif; ?>
            </div>

            <?php /* Support column -- contact, orders, legal, then the links modules add to
                   core's `footer_links` block (Advanced Search, Search Terms, ...). */ ?>
            <div data-hyperion-footer-service>
                <h2 class="text-sm font-semibold uppercase tracking-wider text-on-inverted mb-4">
                    <?= $escaper->escapeHtml(__('Customer service')) ?>
                </h2>
                <ul class="space-y-2 text-sm" role="list">
                    <li>
                        <a href="<?= $escaper->escapeUrl($block->getContactUrl()) ?>"
                           class="text-on-inverted-muted hover:text-primary transition-colors
                                  focus:outline-none focus:ring-2 focus:ring-primary rounded">
                            <?= $escaper->escapeHtml(__('Contact us')) ?>
                        </a>
                    </li>
                    <li>
                        <a href="<?= $escaper->escapeUrl($block->getOrderStatusUrl()) ?>"
                           class="text-on-inverted-muted hover:text-primary transition-colors
                                  focus:outline-none focus:ring-2 focus:ring-primary rounded">
                            <?= $escaper->escapeHtml(__('Order status')) ?>
                        </a>
                    </li>
                    <?php if ($privacyUrl !== ''): ?>
                        <li>
                            <a href="<?= $escaper->escapeUrl($privacyUrl) ?>"
                               class="text-on-inverted-muted hover:text-primary transition-colors
                                      focus:outline-none focus:ring-2 focus:ring-primary rounded">
                                <?= $escaper->escapeHtml(__('Privacy policy')) ?>
                            </a>
                        </li>
                    <?php endif; ?>
                    <?php if ($termsUrl !== ''): ?>
                        <li>
                            <a href="<?= $escaper->escapeUrl($termsUrl) ?>"
                               class="text-on-inverted-muted hover:text-primary transition-colors
                                      focus:outline-none focus:ring-2 focus:ring-primary rounded">
                                <?= $escaper->escapeHtml(__('Terms &amp; conditions')) ?>
                            </a>
                        </li>
                    <?php endif; ?>
                    <?php foreach ($serviceLinks as $link): ?>
                        <li>
                            <a href="<?= $escaper->escapeUrl($link['url']) ?>"
                               class="text-on-inverted-muted hover:text-primary transition-colors
                                      focus:outline-none focus:ring-2 focus:ring-primary rounded">
                                <?= $escaper->escapeHtml($link['label']) ?>
                            </a>
                        </li>
                    <?php endforeach; ?>
                </ul>
            </div>

            <?php /* Newsletter column -- delegated to Magento_Newsletter
                   subscribe block when mounted by layout XML; falls back
                   to an empty column when the subscribe block is absent
                   so the 4-col grid still balances. */ ?>
            <div>
                <h2 class="text-sm font-semibold uppercase tracking-wider text-on-inverted mb-4">
                    <?= $escaper->escapeHtml(__('Stay in the loop')) ?>
                </h2>
                <p class="text-sm mb-4 text-on-inverted-muted">
                    <?= $escaper->escapeHtml(__('Subscribe for new arrivals and exclusive offers.')) ?>
                </p>
                <?= $block->getChildHtml('subscribe') ?>
            </div>

        </div>
    </div>

    <?php /* -- Bottom bar: copyright + switchers --------------- */ ?>
    <div class="container mx-auto px-4 py-6 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-on-inverted-muted">
        <p>
            <?php if ($copyrightText !== ''): ?>
                <?= $escaper->escapeHtml($copyrightText) ?>
            <?php else: ?>
                <?= $escaper->escapeHtml(
                    __('© %1 %2. All rights reserved.', $block->getCurrentYear(), $block->getStoreName())
                ) ?>
            <?php endif; ?>
        </p>

        <div class="flex items-center gap-2">
            <?php /* The store switcher (scope `all`) lists every store view; core's language switcher
                    would repeat them, so it is not rendered (see default.xml). */ ?>
            <?= $block->getChildHtml('store_switcher') ?>
            <?= $block->getChildHtml('currency') ?>
        </div>
    </div>

</footer>
