declare(strict_types=1);

/**
 * Page messages.
 *
 * Magento_Theme's MessagePlugin drains the session message manager into the
 * `mage-messages` cookie on every result so that cached pages can still show
 * feedback; the core template then relies on a Knockout component to read
 * that cookie. Hyperion renders any server-side messages that survived
 * (third-party code adding them after the plugin ran) and mounts
 * <hyperion-messages>, which drains the cookie on the client.
 *
 * @var \Magento\Framework\View\Element\Messages $block
 * @var \Magento\Framework\Escaper $escaper
 */
$messages = (array) $block->getMessageCollection()->getItems();
$toneClasses = [
    'success' => 'border-success/40 bg-success/10 text-success-strong',
    'error' => 'border-error/40 bg-error/10 text-error-strong',
    'warning' => 'border-warning/40 bg-warning/10 text-warning-strong',
    'notice' => 'border-info/40 bg-info/10 text-info',
];
?>
<hyperion-messages class="block container mx-auto px-4 empty:hidden" data-hyperion-messages>
    <?php foreach ($messages as $message): ?>
        <?php $tone = isset($toneClasses[$message->getType()]) ? $message->getType() : 'notice'; ?>
        <div role="alert"
             data-tone="<?= $escaper->escapeHtmlAttr($tone) ?>"
             class="my-3 rounded-lg border px-4 py-3 text-sm <?= $escaper->escapeHtmlAttr($toneClasses[$tone]) ?>">
            <?= $escaper->escapeHtml((string) $message->getText(), ['a', 'b', 'strong', 'i', 'em', 'u', 'span']) ?>
        </div>
    <?php endforeach; ?>
</hyperion-messages>
