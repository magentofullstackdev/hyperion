/**
 * Popular search terms (/search/term/popular/).
 *
 * Core renders a plain list with an inline style per term scaled by its
 * popularity ratio. Here every term is a pill link and the ratio picks one
 * of three literal class tiers (Tailwind only sees literal class strings),
 * so the most searched terms stand out without inline styles. The page
 * heading comes from the generic page.main.title block (the layout's
 * <title>). Nothing here is session bound: the block only reads the
 * `search_query` table of the current store.
 *
 * @var \Magento\Search\Block\Term $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

$terms = $block->getTerms();
$tierClass = static function (float $ratio): string {
    if ($ratio >= 0.66) {
        return 'text-base font-semibold text-secondary border-primary/40 bg-primary/5';
    }
    if ($ratio >= 0.33) {
        return 'text-sm font-medium text-secondary border-subtle bg-surface';
    }
    return 'text-sm text-muted border-subtle bg-surface';
};
?>
<section class="max-w-4xl py-4" data-hyperion-search-terms aria-labelledby="hyperion-search-terms-heading">
    <h2 id="hyperion-search-terms-heading" class="sr-only"><?= $escaper->escapeHtml(__('Popular Search Terms')) ?></h2>
    <?php if (count($terms) > 0): ?>
        <p class="mb-4 text-sm text-muted">
            <?= $escaper->escapeHtml(__('The terms other shoppers search for most. Pick one to see its results.')) ?>
        </p>
        <ul class="flex flex-wrap gap-2" role="list">
            <?php foreach ($terms as $term): ?>
                <li>
                    <a href="<?= $escaper->escapeUrl($block->getSearchUrl($term)) ?>"
                       data-hyperion-search-term
                       class="inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5
                              hover:border-primary hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary
                              transition-colors <?= $escaper->escapeHtmlAttr($tierClass((float) $term->getRatio())) ?>">
                        <?= $escaper->escapeHtml($term->getQueryText()) ?>
                        <span class="text-xs text-muted" aria-hidden="true"><?= (int) $term->getNumResults() ?></span>
                        <span class="sr-only"><?= $escaper->escapeHtml(__('%1 results', (int) $term->getNumResults())) ?></span>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php else: ?>
        <p class="rounded-lg border border-subtle bg-surface px-4 py-6 text-center text-sm text-muted"
           data-hyperion-search-terms-empty>
            <?= $escaper->escapeHtml(__('There are no search terms available.')) ?>
        </p>
    <?php endif; ?>
</section>
