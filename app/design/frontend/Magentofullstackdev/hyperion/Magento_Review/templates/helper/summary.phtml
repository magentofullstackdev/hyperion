/**
 * Hyperion full review summary for the PDP header: SVG stars, review
 * count link, "Add Your Review" link and schema.org AggregateRating
 * microdata. No Luma CSS dependency.
 *
 * @var \Magento\Review\Block\Product\ReviewRenderer $block
 * @var \Magento\Framework\Escaper $escaper
 */
$url = $block->getReviewsUrl() . '#reviews';
$urlForm = $block->getReviewsUrl() . '#review-form';
$count = (int) $block->getReviewsCount();
$rating = (int) $block->getRatingSummary();
$steps = 5;
$filled = $rating > 0 ? (int) floor($rating / 100 * $steps) : 0;
$empty = $steps - $filled;

$starFilled = '<svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
$starEmpty = '<svg class="w-4 h-4 text-muted" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
?>
<?php if ($block->isReviewEnabled() && $count > 0): ?>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted"
         itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
        <meta itemprop="ratingValue" content="<?= (int) $rating ?>">
        <meta itemprop="bestRating" content="100">
        <meta itemprop="reviewCount" content="<?= (int) $count ?>">
        <div class="flex items-center gap-0.5"
             role="img"
             aria-label="<?= $escaper->escapeHtmlAttr(__('%1 out of %2 stars', $filled, $steps)) ?>">
            <?php for ($i = 0; $i < $filled; $i++): ?>
                <?= /* @noEscape */ $starFilled ?>
            <?php endfor; ?>
            <?php for ($i = 0; $i < $empty; $i++): ?>
                <?= /* @noEscape */ $starEmpty ?>
            <?php endfor; ?>
        </div>
        <a href="<?= $escaper->escapeUrl($url) ?>"
           class="text-primary hover:text-primary-hover hover:underline transition-colors">
            <?= $count === 1
                ? $escaper->escapeHtml(__('1 Review'))
                : $escaper->escapeHtml(__('%1 Reviews', $count)) ?>
        </a>
        <a href="<?= $escaper->escapeUrl($urlForm) ?>"
           class="text-primary hover:text-primary-hover hover:underline transition-colors">
            <?= $escaper->escapeHtml(__('Add Your Review')) ?>
        </a>
    </div>
<?php elseif ($block->isReviewEnabled() && $block->getDisplayIfEmpty()): ?>
    <a href="<?= $escaper->escapeUrl($urlForm) ?>"
       class="text-sm text-primary hover:text-primary-hover hover:underline transition-colors">
        <?= $escaper->escapeHtml(__('Be the first to review this product')) ?>
    </a>
<?php endif; ?>
