declare(strict_types=1);
/**
 * Hyperion customer dashboard "My Recent Reviews" section: the last five
 * reviews of the customer with their star rating, each linking to the
 * review detail page. Renders nothing when the customer has no reviews.
 *
 * @var \Magento\Review\Block\Customer\Recent $block
 * @var \Magento\Framework\Escaper $escaper
 */
$reviews = $block->getReviews();
if (!$reviews || !count($reviews)) {
    return;
}
$steps = 5;

$starFilled = '<svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
$starEmpty = '<svg class="w-4 h-4 text-muted" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
?>
<section class="space-y-4" aria-labelledby="hyperion-dashboard-reviews-heading">

    <div class="flex items-center justify-between gap-4 flex-wrap">
        <h2 id="hyperion-dashboard-reviews-heading"
            class="text-xl font-semibold text-secondary">
            <?= $escaper->escapeHtml(__('My Recent Reviews')) ?>
        </h2>

        <a href="<?= $escaper->escapeUrl($block->getAllReviewsUrl()) ?>"
           class="text-sm font-medium text-primary hover:text-primary-hover underline-offset-2 hover:underline">
            <?= $escaper->escapeHtml(__('View All')) ?>
        </a>
    </div>

    <ol class="bg-surface border border-subtle rounded-xl overflow-hidden" role="list">
        <?php foreach ($reviews as $review): ?>
            <?php
                $voteCount = (int) $review->getCount();
                $percent = $voteCount > 0 ? (int) round((int) $review->getSum() / $voteCount) : 0;
                $filled = (int) floor($percent / 100 * $steps);
                $empty = $steps - $filled;
            ?>
            <li class="flex items-center justify-between gap-4 flex-wrap
                       px-5 py-4 border-b border-subtle last:border-b-0">
                <a href="<?= $escaper->escapeUrl($block->getReviewUrl($review->getReviewId())) ?>"
                   class="text-sm font-medium text-secondary hover:text-primary transition-colors">
                    <?= $escaper->escapeHtml($review->getName()) ?>
                </a>
                <?php if ($percent > 0): ?>
                    <div class="flex items-center gap-0.5"
                         role="img"
                         aria-label="<?= $escaper->escapeHtmlAttr(__('%1 out of %2 stars', $filled, $steps)) ?>">
                        <?php for ($i = 0; $i < $filled; $i++): ?>
                            <?= /* @noEscape */ $starFilled ?>
                        <?php endfor; ?>
                        <?php for ($i = 0; $i < $empty; $i++): ?>
                            <?= /* @noEscape */ $starEmpty ?>
                        <?php endfor; ?>
                    </div>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ol>
</section>
