declare(strict_types=1);
/**
 * Hyperion "My Product Reviews" -- reviews written by the signed-in
 * customer: date, product link, star rating, truncated text and a link
 * to the review detail page. Grid table on md+, stacked rows below.
 *
 * @var \Magento\Review\Block\Customer\ListCustomer $block
 * @var \Magento\Framework\Escaper $escaper
 */

/** @var \Magento\Review\Helper\Data $reviewHelper */
$reviewHelper = $block->getData('reviewHelper');
$reviews = $block->getReviews();
$toolbarHtml = (string) $block->getToolbarHtml();
$steps = 5;

$starFilled = '<svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
$starEmpty = '<svg class="w-4 h-4 text-muted" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
?>
<section class="space-y-4" aria-labelledby="hyperion-reviews-heading">

    <h2 id="hyperion-reviews-heading" class="text-xl font-semibold text-secondary">
        <?= $escaper->escapeHtml(__('My Product Reviews')) ?>
    </h2>

    <?php if ($reviews && count($reviews)): ?>
        <div class="bg-surface border border-subtle rounded-xl overflow-hidden">

            <div class="hidden md:grid md:grid-cols-[8rem_minmax(10rem,1.5fr)_8rem_minmax(10rem,2fr)_6rem]
                        gap-4 px-5 py-3 border-b border-subtle
                        text-xs font-bold uppercase tracking-wider text-secondary bg-surface-raised">
                <div><?= $escaper->escapeHtml(__('Created')) ?></div>
                <div><?= $escaper->escapeHtml(__('Product Name')) ?></div>
                <div><?= $escaper->escapeHtml(__('Rating')) ?></div>
                <div><?= $escaper->escapeHtml(__('Review')) ?></div>
                <div class="text-right"><?= $escaper->escapeHtml(__('Actions')) ?></div>
            </div>

            <?php foreach ($reviews as $review): ?>
                <?php
                    $voteCount = (int) $review->getCount();
                    $percent = $voteCount > 0 ? (int) round((int) $review->getSum() / $voteCount) : 0;
                    $filled = (int) floor($percent / 100 * $steps);
                    $empty = $steps - $filled;
                ?>
                <div class="md:grid md:grid-cols-[8rem_minmax(10rem,1.5fr)_8rem_minmax(10rem,2fr)_6rem]
                            md:gap-4 md:items-center
                            px-5 py-4 border-b border-subtle last:border-b-0
                            flex flex-col gap-2">

                    <div class="flex justify-between md:block">
                        <span class="md:hidden text-xs uppercase tracking-wider text-muted font-semibold">
                            <?= $escaper->escapeHtml(__('Created')) ?>
                        </span>
                        <span class="text-sm text-secondary">
                            <?= $escaper->escapeHtml($block->dateFormat($review->getReviewCreatedAt())) ?>
                        </span>
                    </div>

                    <div class="flex justify-between gap-4 md:block">
                        <span class="md:hidden text-xs uppercase tracking-wider text-muted font-semibold">
                            <?= $escaper->escapeHtml(__('Product Name')) ?>
                        </span>
                        <a href="<?= $escaper->escapeUrl($block->getProductUrl($review)) ?>"
                           class="text-sm font-medium text-secondary hover:text-primary transition-colors">
                            <?= $escaper->escapeHtml($review->getName()) ?>
                        </a>
                    </div>

                    <div class="flex justify-between md:block">
                        <span class="md:hidden text-xs uppercase tracking-wider text-muted font-semibold">
                            <?= $escaper->escapeHtml(__('Rating')) ?>
                        </span>
                        <?php if ($percent > 0): ?>
                            <div class="flex items-center gap-0.5"
                                 role="img"
                                 aria-label="<?= $escaper->escapeHtmlAttr(__('%1 out of %2 stars', $filled, $steps)) ?>">
                                <?php for ($i = 0; $i < $filled; $i++): ?>
                                    <?= /* @noEscape */ $starFilled ?>
                                <?php endfor; ?>
                                <?php for ($i = 0; $i < $empty; $i++): ?>
                                    <?= /* @noEscape */ $starEmpty ?>
                                <?php endfor; ?>
                            </div>
                        <?php endif; ?>
                    </div>

                    <div class="text-sm text-secondary leading-relaxed">
                        <?= /* @noEscape */ $reviewHelper->getDetailHtml($review->getDetail()) ?>
                    </div>

                    <div class="flex justify-end">
                        <a href="<?= $escaper->escapeUrl($block->getReviewUrl($review)) ?>"
                           class="text-sm font-medium text-primary hover:text-primary-hover underline-offset-2 hover:underline">
                            <?= $escaper->escapeHtml(__('See Details')) ?>
                        </a>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>

        <?php if ($toolbarHtml !== ''): ?>
            <div class="flex items-center justify-end gap-4 flex-wrap">
                <?= /* @noEscape */ $toolbarHtml ?>
            </div>
        <?php endif; ?>
    <?php else: ?>
        <div class="py-16 text-center space-y-3 bg-surface border border-subtle rounded-xl" role="status">
            <svg class="w-12 h-12 mx-auto text-muted" fill="none" stroke="currentColor"
                 viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
            </svg>
            <p class="text-muted">
                <?= $escaper->escapeHtml(__('You have submitted no reviews.')) ?>
            </p>
        </div>
    <?php endif; ?>

    <div class="flex items-center justify-end pt-4 border-t border-subtle">
        <a href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>"
           class="text-sm font-medium text-primary hover:text-primary-hover underline-offset-2 hover:underline">
            <?= $escaper->escapeHtml(__('Back')) ?>
        </a>
    </div>
</section>
