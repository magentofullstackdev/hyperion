declare(strict_types=1);

/**
 * One gift message editor of the cart page (order level or one item),
 * rendered by Magento_Checkout::cart/items.phtml through the
 * `gift_message` child block.
 *
 * The fields are associated through the `form` attribute with an empty
 * `<form id="...">` that items.phtml prints OUTSIDE the cart update form
 * (forms cannot nest, and the item editors live inside the update form
 * next to their quantity inputs). Enter in a field and the buttons
 * therefore submit the gift form, which HTMX posts to
 * HyperionCheckout\Controller\Cart\GiftMessage and swaps the cart back.
 *
 * Block data:
 *   form_id   id of the associated empty form
 *   item_id   quote item id, 0 for the order-level message
 *   values    ['sender' => .., 'recipient' => .., 'message' => ..]
 *   title     summary text
 *   form_key  CSRF token
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
$formId = $escaper->escapeHtmlAttr((string) $block->getData('form_id'));
$itemId = (int) $block->getData('item_id');
$values = (array) $block->getData('values');
$sender = (string) ($values['sender'] ?? '');
$recipient = (string) ($values['recipient'] ?? '');
$message = (string) ($values['message'] ?? '');
$hasMessage = $message !== '';
$fieldPrefix = 'hyperion-gift-' . ($itemId > 0 ? 'item-' . $itemId : 'order');
$inputClasses = 'w-full rounded-lg border border-subtle bg-surface px-3 py-2 text-sm text-secondary'
    . ' focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary';
?>
<details class="group rounded-xl border border-subtle bg-surface-raised text-sm"
         data-hyperion-gift-message="<?= (int) $itemId ?>"
         <?= $hasMessage ? 'open' : '' ?>>
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3
                    font-medium text-secondary [&::-webkit-details-marker]:hidden
                    focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-xl">
        <span class="inline-flex items-center gap-2">
            <svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                 stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H4.5a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0H4.5a1.5 1.5 0 00-1.5 1.5v1.5c0 .414.336.75.75.75h16.5a.75.75 0 00.75-.75V9a1.5 1.5 0 00-1.5-1.5H12m0 0v13.5"/>
            </svg>
            <?= $escaper->escapeHtml((string) $block->getData('title')) ?>
        </span>
        <span class="inline-flex items-center gap-2 text-xs text-muted">
            <?php if ($hasMessage): ?>
                <span class="rounded-full bg-success/10 px-2 py-0.5 font-semibold text-success-strong"
                      data-hyperion-gift-added>
                    <?= $escaper->escapeHtml(__('Added')) ?>
                </span>
            <?php endif; ?>
            <svg class="h-4 w-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor"
                 viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
        </span>
    </summary>
    <div class="grid gap-3 px-4 pb-4 sm:grid-cols-2">
        <input type="hidden" name="form_key"
               value="<?= $escaper->escapeHtmlAttr((string) $block->getData('form_key')) ?>"
               form="<?= /* @noEscape */ $formId ?>">
        <input type="hidden" name="gift[item_id]" value="<?= (int) $itemId ?>" form="<?= /* @noEscape */ $formId ?>">
        <label class="flex flex-col gap-1" for="<?= /* @noEscape */ $fieldPrefix ?>-sender">
            <span class="text-xs text-muted"><?= $escaper->escapeHtml(__('From')) ?></span>
            <input type="text"
                   id="<?= /* @noEscape */ $fieldPrefix ?>-sender"
                   name="gift[sender]"
                   value="<?= $escaper->escapeHtmlAttr($sender) ?>"
                   maxlength="255"
                   autocomplete="off"
                   form="<?= /* @noEscape */ $formId ?>"
                   class="<?= /* @noEscape */ $inputClasses ?>">
        </label>
        <label class="flex flex-col gap-1" for="<?= /* @noEscape */ $fieldPrefix ?>-recipient">
            <span class="text-xs text-muted"><?= $escaper->escapeHtml(__('To')) ?></span>
            <input type="text"
                   id="<?= /* @noEscape */ $fieldPrefix ?>-recipient"
                   name="gift[recipient]"
                   value="<?= $escaper->escapeHtmlAttr($recipient) ?>"
                   maxlength="255"
                   autocomplete="off"
                   form="<?= /* @noEscape */ $formId ?>"
                   class="<?= /* @noEscape */ $inputClasses ?>">
        </label>
        <label class="flex flex-col gap-1 sm:col-span-2" for="<?= /* @noEscape */ $fieldPrefix ?>-message">
            <span class="text-xs text-muted"><?= $escaper->escapeHtml(__('Message')) ?></span>
            <textarea id="<?= /* @noEscape */ $fieldPrefix ?>-message"
                      name="gift[message]"
                      rows="3"
                      maxlength="2000"
                      form="<?= /* @noEscape */ $formId ?>"
                      class="<?= /* @noEscape */ $inputClasses ?>"><?= $escaper->escapeHtml($message) ?></textarea>
        </label>
        <div class="flex flex-wrap items-center gap-3 sm:col-span-2">
            <?php /* nowrap: "Salva messaggio regalo" wrapped to three lines in the line column; the row wraps instead. */ ?>
            <button type="submit"
                    form="<?= /* @noEscape */ $formId ?>"
                    class="inline-flex items-center whitespace-nowrap rounded-lg border border-subtle bg-surface px-4 py-2
                           text-sm font-medium text-secondary transition-colors hover:border-primary
                           hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary">
                <?= $escaper->escapeHtml($hasMessage ? __('Update Gift Message') : __('Save Gift Message')) ?>
            </button>
            <?php if ($hasMessage): ?>
                <button type="submit"
                        form="<?= /* @noEscape */ $formId ?>"
                        name="remove"
                        value="1"
                        class="rounded text-xs text-muted underline-offset-2 transition-colors hover:text-error
                               hover:underline focus:outline-none focus:ring-2 focus:ring-error">
                    <?= $escaper->escapeHtml(__('Remove Gift Message')) ?>
                </button>
            <?php endif; ?>
        </div>
    </div>
</details>
