        <dt class="text-muted"><?= $escaper->escapeHtml(__('To')) ?></dt>
        <dd class="text-secondary"><?= $escaper->escapeHtml((string) ($values['recipient'] ?? '')) ?></dd>
        <dt class="text-muted"><?= $escaper->escapeHtml(__('Message')) ?></dt>
        <dd class="whitespace-pre-line text-secondary"><?= $escaper->escapeHtml((string) ($values['message'] ?? '')) ?></dd>
    </dl>
</div>
