declare(strict_types=1);
/**
 * One stored ACH Direct Debit account of the Braintree gateway (Stored Payment Methods).
 * Delete is a plain POST to `vault/cards/deleteaction` behind the site dialog
 * (`data-hyperion-confirm`, entry.js), as for the stored cards. The block is
 * the gateway module's token renderer; this template only renders when that
 * module is installed.
 *
 * @var \Magento\Vault\Block\AbstractTokenRenderer $block
 * @var \Magento\Framework\Escaper $escaper
 */
use Magento\Vault\Api\Data\PaymentTokenInterface;

$last4 = (string) $block->getAccountNumberLastFourDigits();
$routingNumber = (string) $block->getBankRoutingNumber();
?>
<tr data-hyperion-vault-token="ach">
    <td class="col">
        <span class="inline-flex items-center gap-3">
            <?php if ($block->getIconUrl()): ?>
                <img src="<?= $escaper->escapeUrl($block->getIconUrl()) ?>"
                     width="<?= (int) $block->getIconWidth() ?>"
                     height="<?= (int) $block->getIconHeight() ?>"
                     alt="<?= $escaper->escapeHtmlAttr(__('ACH Direct Debit')) ?>"
                     class="inline-block h-6 w-auto">
            <?php endif; ?>
            <span>
                <?= $escaper->escapeHtml(__('ending')) ?> <span class="font-mono font-semibold"><?= $escaper->escapeHtml($last4) ?></span>
                <?php if ($routingNumber !== ''): ?>
                    <span class="text-muted">(<?= $escaper->escapeHtml(__('Bank Routing Number')) ?>: <?= $escaper->escapeHtml($routingNumber) ?>)</span>
                <?php endif; ?>
            </span>
        </span>
    </td>
    <td class="col actions text-right">
        <form action="<?= $escaper->escapeUrl($block->getUrl('vault/cards/deleteaction')) ?>"
              method="post"
              class="inline"
              data-hyperion-confirm="<?= $escaper->escapeHtmlAttr(__('Are you sure you want to delete this ACH Direct Debit account number ending in: %1?', $last4)) ?>">
            <?= $block->getBlockHtml('formkey') ?>
            <input type="hidden" name="<?= /* @noEscape */ PaymentTokenInterface::PUBLIC_HASH ?>"
                   value="<?= $escaper->escapeHtmlAttr($block->getToken()->getPublicHash()) ?>">
            <button type="submit"
                    class="text-sm font-medium text-error hover:underline underline-offset-2"
                    data-hyperion-vault-delete>
                <?= $escaper->escapeHtml(__('Delete')) ?>
            </button>
        </form>
    </td>
</tr>
