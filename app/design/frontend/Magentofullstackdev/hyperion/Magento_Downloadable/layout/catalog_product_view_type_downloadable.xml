<!--
    Hyperion override for the Magento_Downloadable PDP handle.

    The vendor handle targets `product.info.main` and
    `product.info.options.wrapper` - both removed by
    Magentofullstackdev/hyperion/Magento_Catalog/layout/catalog_product_view.xml. Without
    re-parenting the Samples / Links blocks they silently drop off the page,
    producing the missing "Trailers" and "Downloads" sections reported on
    /lifelong-fitness-iv (Luma renders both sections).

    We reparent both blocks under `hyperion.product.view` with the same
    aliases the Hyperion PDP template reaches for via getChildHtml:

        samples                     - "Trailers" list, rendered above the
                                      add-to-cart form
        type_downloadable_options   - "Downloads" checkbox list, rendered
                                      inside the add-to-cart form so the
                                      selected links post with the cart add
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <attribute name="class" value="page-product-downloadable"/>

        <referenceBlock name="hyperion.product.view">
            <block class="Magento\Downloadable\Block\Catalog\Product\Samples"
                   name="hyperion.product.downloadable.samples"
                   as="samples"
                   template="Magento_Downloadable::catalog/product/samples.phtml"/>

            <block class="Magento\Downloadable\Block\Catalog\Product\Links"
                   name="hyperion.product.downloadable.options"
                   as="type_downloadable_options"
                   template="Magento_Downloadable::catalog/product/links.phtml">
                <block class="Magento\Catalog\Pricing\Render"
                       name="hyperion.product.price.link">
                    <arguments>
                        <argument name="price_render" xsi:type="string">product.price.render.default</argument>
                        <argument name="price_type_code" xsi:type="string">link_price</argument>
                    </arguments>
                </block>
            </block>
        </referenceBlock>
    </body>
</page>
