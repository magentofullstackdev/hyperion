<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Remove the default Luma swatch and configurable-option blocks
             so the Swatches template is not rendered twice. -->
        <referenceBlock name="product.info.options.swatches" remove="true"/>
        <referenceBlock name="product.info.options.configurable" remove="true"/>
        <referenceContainer name="product.info.options.wrapper" remove="true"/>

        <!-- Inject swatch options inside our custom PDP block.
             The Swatches block self-selects its template based on whether the
             product has swatch attributes; our theme provides overrides under
             Magento_Swatches/product/view/ templates. -->
        <referenceBlock name="hyperion.product.view">
            <block class="Magento\Swatches\Block\Product\Renderer\Configurable"
                   name="hyperion.product.options.swatches"
                   as="options_configurable">
                <arguments>
                    <argument name="configurable_view_model"
                              xsi:type="object">Magento\Swatches\ViewModel\Product\Renderer\Configurable</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
