declare(strict_types=1);
/**
 * Landing page of the admin "Login as Customer" secret link
 * (`loginascustomer/login/index/secret/...`).
 *
 * The controller has already authenticated the session before this
 * renders; core's template only reloads the customer-data sections with
 * RequireJS and then redirects. Hyperion has neither, so the page sends
 * the visitor straight to the account dashboard (script, with a link as
 * the no-script fallback).
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */
$redirectUrl = $block->getUrl('customer/account/index');
$script = 'window.location.replace('
    . json_encode($redirectUrl, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES)
    . ');';
?>
<div class="py-12 text-center space-y-4" role="status" aria-live="polite">
    <p class="text-base text-secondary"><?= $escaper->escapeHtml(__('You are logged in.')) ?></p>
    <a href="<?= $escaper->escapeUrl($redirectUrl) ?>"
       class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold
              bg-primary text-on-primary hover:bg-primary-hover transition-colors">
        <?= $escaper->escapeHtml(__('Continue to My Account')) ?>
    </a>
</div>
<?= /* @noEscape */ $secureRenderer->renderTag('script', ['type' => 'module'], $script, false) ?>
