<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="hyperion_sales_totals"/>
    <body>
        <!-- Same shell as the customer order view: info card inside it, visible comments below -->
        <move element="sales.order.info" destination="sales.order.view" as="info"/>
        <referenceBlock name="sales.order.view">
            <arguments>
                <argument name="show_comments" xsi:type="boolean">true</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
