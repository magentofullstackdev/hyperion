declare(strict_types=1);
/**
 * Print refund(s) of an order (one credit memo, or every one of the order).
 *
 * @var \Magento\Sales\Block\Order\PrintOrder\Creditmemo $block
 * @var \Magento\Framework\Escaper $escaper
 */
$order = $block->getOrder();
$creditmemos = $block->getCreditmemo() ? [$block->getCreditmemo()] : iterator_to_array($order->getCreditmemosCollection());
$details = (string) $block->getTemplateFile('Magento_Sales::order/print/details.phtml');
?>
<div class="container mx-auto px-4 pb-10 space-y-8" data-hyperion-print="creditmemo">
    <?php if ($creditmemos === []): ?>
        <p class="text-sm text-muted" data-hyperion-print-empty>
            <?= $escaper->escapeHtml(__('There are no refunds for this order.')) ?>
        </p>
    <?php endif; ?>
    <?php foreach ($creditmemos as $creditmemo): ?>
        <section class="space-y-4" aria-label="<?= $escaper->escapeHtmlAttr(__('Refund #%1', $creditmemo->getIncrementId())) ?>">
            <article class="bg-surface border border-subtle rounded-xl p-5 space-y-4">
                <h2 class="text-base font-semibold text-secondary">
                    <?= $escaper->escapeHtml(__('Refund #%1', $creditmemo->getIncrementId())) ?>
                </h2>
                <div class="overflow-x-auto">
                    <table class="hyperion-order-table" aria-label="<?= $escaper->escapeHtmlAttr(__('Items Refunded')) ?>">
                        <thead>
                            <tr>
                                <th scope="col" class="col name"><?= $escaper->escapeHtml(__('Product Name')) ?></th>
                                <th scope="col" class="col sku"><?= $escaper->escapeHtml(__('SKU')) ?></th>
                                <th scope="col" class="col price"><?= $escaper->escapeHtml(__('Price')) ?></th>
                                <th scope="col" class="col qty"><?= $escaper->escapeHtml(__('Qty')) ?></th>
                                <th scope="col" class="col subtotal"><?= $escaper->escapeHtml(__('Subtotal')) ?></th>
                                <th scope="col" class="col discount"><?= $escaper->escapeHtml(__('Discount Amount')) ?></th>
                                <th scope="col" class="col total"><?= $escaper->escapeHtml(__('Row Total')) ?></th>
                            </tr>
                        </thead>
                        <?php foreach ($creditmemo->getAllItems() as $item): ?>
                            <?php if (!$item->getOrderItem()->getParentItem()): ?>
                                <tbody><?= $block->getItemHtml($item) ?></tbody>
                            <?php endif; ?>
                        <?php endforeach; ?>
                    </table>
                </div>
                <?= $block->getTotalsHtml($creditmemo) ?>
            </article>
            <?php
            $block->addData([
                'print_is_virtual' => (bool) $order->getIsVirtual(),
                'print_shipping_address_html' => $order->getIsVirtual() ? '' : $block->formatAddress($creditmemo->getShippingAddress(), 'html'),
                'print_billing_address_html' => $block->formatAddress($order->getBillingAddress(), 'html'),
                'print_shipping_method' => (string) $order->getShippingDescription(),
                'print_tracks' => [],
            ]);
            ?>
            <?= /* @noEscape */ $block->fetchView($details) ?>
        </section>
    <?php endforeach; ?>
</div>
