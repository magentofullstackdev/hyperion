/**
 * Hyperion compare products table.
 *
 * @var \Magento\Catalog\Block\Product\Compare\ListCompare $block
 * @var \Magentofullstackdev\HyperionCore\Model\ViewModelRegistry $viewModels
 * @var \Magento\Framework\Escaper $escaper
 */
$items = $block->getItems();
$total = $items->getSize();
$compareHelper = $this->helper(\Magento\Catalog\Helper\Product\Compare::class);
$outputHelper = $this->helper(\Magento\Catalog\Helper\Output::class);
$formKey = $viewModels->require(\Magentofullstackdev\HyperionCore\ViewModel\FormKey::class)->getFormKey();
$canPurchase = $viewModels->require(\Magentofullstackdev\HyperionCore\ViewModel\Purchase::class)->canPurchase();
$pricing = $viewModels->require(\Magentofullstackdev\HyperionCatalog\ViewModel\Pricing::class);
?>

<?php if ($total): ?>
    <div class="bg-surface rounded-xl border border-subtle shadow-sm overflow-x-auto">
        <table class="min-w-full text-sm">
            <thead class="border-b border-subtle">
                <tr>
                    <th scope="row" class="w-40 px-4 py-4 text-left text-xs uppercase tracking-wider text-muted font-semibold align-top">
                        <?= $escaper->escapeHtml(__('Product')) ?>
                    </th>
                    <?php foreach ($items as $item): ?>
                        <td class="px-4 py-4 align-top text-center min-w-[200px]">
                            <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('catalog/product_compare/remove')) ?>" class="inline-block mb-3">
                                <input type="hidden" name="product" value="<?= (int) $item->getId() ?>"/>
                                <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>"/>
                                <button type="submit"
                                        class="text-muted hover:text-error transition-colors inline-flex items-center gap-1 text-xs"
                                        aria-label="<?= $escaper->escapeHtmlAttr(__('Remove Product')) ?>">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                    </svg>
                                    <?= $escaper->escapeHtml(__('Remove')) ?>
                                </button>
                            </form>

                            <a href="<?= $escaper->escapeUrl($block->getProductUrl($item)) ?>"
                               class="block aspect-square bg-surface-raised rounded-lg overflow-hidden mb-3 max-w-[140px] mx-auto">
                                <?php
                                    // `getImage()` returns null when the
                                    // image role is unresolved -- fall back
                                    // to a direct image helper call so the
                                    // tile always renders a thumbnail.
                                    $imgBlock = $block->getImage($item, 'product_comparison_list');
                                ?>
                                <?php if ($imgBlock): ?>
                                    <?= $imgBlock->toHtml() ?>
                                <?php else: ?>
                                    <img src="<?= $escaper->escapeUrl(
                                        $this->helper(\Magento\Catalog\Helper\Image::class)
                                             ->init($item, 'product_small_image')->getUrl()
                                    ) ?>"
                                         alt="<?= $escaper->escapeHtmlAttr((string) $item->getName()) ?>"
                                         class="w-full h-full object-cover"
                                         loading="lazy">
                                <?php endif; ?>
                            </a>

                            <a href="<?= $escaper->escapeUrl($block->getProductUrl($item)) ?>"
                               class="block text-sm font-medium text-secondary hover:text-primary transition-colors mb-2">
                                <?= /* @noEscape */ $outputHelper->productAttribute($item, $item->getName(), 'name') ?>
                            </a>

                            <div class="text-sm font-bold text-secondary mb-3">
                                <?= /* @noEscape */ $pricing->getCompareHtml($item, '-compare-list-top') ?>
                            </div>

                            <?php if ($canPurchase && $item->isSaleable()): ?>
                                <form method="post"
                                      action="<?= $escaper->escapeUrl($compareHelper->getAddToCartUrl($item)) ?>">
                                    <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>"/>
                                    <button type="submit"
                                            class="w-full py-2 px-3 text-xs font-bold text-white bg-primary rounded-lg hover:bg-primary-hover transition-colors">
                                        <?= $escaper->escapeHtml(__('Add to Cart')) ?>
                                    </button>
                                </form>
                            <?php elseif ($canPurchase): ?>
                                <p class="text-xs text-error font-medium"><?= $escaper->escapeHtml(__('Out of stock')) ?></p>
                            <?php endif; ?>
                        </td>
                    <?php endforeach; ?>
                </tr>
            </thead>

            <tbody class="divide-y divide-divider">
                <?php foreach ($block->getAttributes() as $attribute): ?>
                    <?php if (!$block->hasAttributeValueForProducts($attribute)) continue; ?>
                    <tr>
                        <th scope="row" class="px-4 py-3 text-left text-xs uppercase tracking-wider text-muted font-semibold align-top">
                            <?= $escaper->escapeHtml($attribute->getStoreLabel() ?: __($attribute->getFrontendLabel())) ?>
                        </th>
                        <?php foreach ($items as $item): ?>
                            <td class="px-4 py-3 text-sm text-secondary align-top text-center">
                                <?php switch ($attribute->getAttributeCode()) {
                                    case 'price': ?>
                                        <?= /* @noEscape */ $pricing->getCompareHtml($item, '-compare-list-' . $attribute->getCode()) ?>
                                        <?php break;
                                    case 'small_image': ?>
                                        <?= /* @noEscape */ $block->getImage($item, 'product_small_image')->toHtml() ?>
                                        <?php break;
                                    default:
                                        $value = $block->getProductAttributeValue($item, $attribute);
                                        if (is_string($value)):
                                            /* @noEscape */ echo $outputHelper->productAttribute($item, $value, $attribute->getAttributeCode());
                                        else:
                                            echo $escaper->escapeHtml($outputHelper->productAttribute($item, $value, $attribute->getAttributeCode()));
                                        endif;
                                        break;
                                } ?>
                            </td>
                        <?php endforeach; ?>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
<?php else: ?>
    <div class="bg-surface rounded-xl border border-subtle py-16 text-center" role="status">
        <p class="text-muted">
            <?= $escaper->escapeHtml(__('You have no items to compare.')) ?>
        </p>
    </div>
<?php endif; ?>
