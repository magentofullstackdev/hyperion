/**
 * Infinite loading foot of the product grid: the status line and
 * the "Load more" link that appends the next page under the tiles.
 *
 * Child `load_more` of the list block (category and search results). Rendered
 * only when the listing's resolved mode is not disabled; the pager renders
 * otherwise. The link is a real anchor to the next page (crawlers and
 * visitors without JavaScript paginate) carrying the HTMX attributes that
 * fetch the grid fragment with `append=1` (the next page of the listing as it
 * is filtered now, Listing::getAppendFragmentUrl()) and append its tiles to
 * the list.
 * In the automatic mode the link also triggers when it enters the viewport,
 * until the configured number of automatic loads is reached.
 *
 * In an append answer this block is the out of band replacement of the one on
 * the page (fresh status, fresh link, the GA4 record of the page).
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

$listing = $viewModels->require(\Magentofullstackdev\HyperionCatalog\ViewModel\Listing::class);
$list = $block->getParentBlock();
$toolbar = $block->getLayout()->getBlock('product_list_toolbar');
if (!$list instanceof \Magento\Catalog\Block\Product\ListProduct
    || !$toolbar instanceof \Magento\Catalog\Block\Product\ProductList\Toolbar
    || !$listing->isInfinite($list)
) {
    return;
}
$total = (int) $toolbar->getTotalNum();
if ($total === 0) {
    return;
}
$append = $listing->isAppend();
$current = max(1, (int) $toolbar->getCurrentPage());
$last = max(1, (int) $toolbar->getLastPageNum());
$shown = min($total, max(0, (int) $toolbar->getLastNum()));
$hasMore = $current < $last;
$next = $current + 1;
$appendUrl = $listing->getAppendFragmentUrl($list, $next);
$gridId = $listing->getGridTargetId();
$automatic = $hasMore && $listing->isAutomaticLoad($list, $current);
// Inside an append answer core builds the pager URL on the fragment route: the view model gives the page URL.
$nextUrl = $listing->toPublicUrl($list, (string) $toolbar->getPagerUrl(['p' => $next]));
$viewListJson = $append ? (string) $list->getData('hyperion_view_list_json') : '';
?>
<div id="hyperion-load-more"
     data-hyperion-load-more
     data-hyperion-load-more-mode="<?= $escaper->escapeHtmlAttr($automatic ? 'scroll' : 'button') ?>"
     class="flex flex-col items-center gap-3 py-6 text-center border-t border-subtle"<?= $append ? ' hx-swap-oob="true"' : '' ?>>
    <?php if ($viewListJson !== ''): ?>
        <span data-hyperion-gtag-event="view_item_list" data-hyperion-gtag-payload="<?= $escaper->escapeHtmlAttr($viewListJson) ?>" hidden></span>
    <?php endif; ?>
    <p class="text-sm text-muted" role="status" aria-live="polite" tabindex="-1" data-hyperion-load-more-status>
        <?php if ($hasMore): ?>
            <?= $escaper->escapeHtml(__('Showing %1 of %2 products', $shown, $total)) ?>
        <?php else: ?>
            <?= $escaper->escapeHtml(__('You have seen all %1 products', $total)) ?>
        <?php endif; ?>
    </p>
    <?php if ($hasMore): ?>
        <a href="<?= $escaper->escapeUrl($nextUrl) ?>"
           class="inline-flex items-center justify-center gap-2 rounded-md border border-primary px-6 py-2.5 text-sm font-semibold text-primary hover:bg-primary hover:text-on-primary focus:outline-none focus:ring-2 focus:ring-primary transition-colors"
           data-hyperion-load-more-button
           <?php if ($appendUrl !== ''): ?>
           hx-get="<?= $escaper->escapeUrl($appendUrl) ?>"
           hx-target="#<?= $escaper->escapeHtmlAttr($gridId) ?> [data-hyperion-tiles]"
           hx-swap="beforeend"
           hx-include="[data-hyperion-toolbar] select, [data-hyperion-toolbar] input[type=hidden]"
           hx-indicator="#hyperion-load-more"
           hx-trigger="<?= $automatic ? 'intersect once, click' : 'click' ?>"
           <?php endif; ?>>
            <span data-hyperion-load-more-label><?= $escaper->escapeHtml(__('Load more')) ?></span>
            <span data-hyperion-load-more-loading hidden><?= $escaper->escapeHtml(__('Loading...')) ?></span>
        </a>
    <?php endif; ?>
</div>
