            <?php /* -- Stock + price alerts -------------------- */ ?>
            <div class="flex items-center gap-2 text-sm">
                <?php if ($isAvailable): ?>
                    <svg class="w-4 h-4 text-success" fill="none" stroke="currentColor"
                         stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-success font-medium">
                        <?= $escaper->escapeHtml(__('In Stock')) ?>
                    </span>
                    <?php if ($lowStockVisible): ?>
                        <span class="inline-flex items-center rounded-full bg-warning/10 px-2 py-0.5 text-xs font-semibold text-warning-strong"
                              data-hyperion-low-stock="<?= $escaper->escapeHtmlAttr($qtyText($stockQtyLeft)) ?>">
                            <?= $escaper->escapeHtml(__('Only %1 left', $qtyText($stockQtyLeft))) ?>
                        </span>
                    <?php endif; ?>
                    <?php if ($isConfigurable): ?>
                        <?php /* "Only N left" of the matched variant: <hyperion-swatches> (`stock-target`) fills it
