    <?php if ($isFullWidth): ?>
        </div>
        <?php if ($description): ?>
            <div id="description" class="product-full-width-section mb-12">
                <?= /* @noEscape */ $description ?>
            </div>
        <?php endif; ?>
        <?= $block->getChildHtml('product.attributes.pagebuilder') ?>
        <div class="<?= $escaper->escapeHtmlAttr($containerClass) ?>">
    <?php endif; ?>

    <?php /* -- Detail tabs (description / attributes / reviews) -- */ ?>
    <?php
    $tabs = [];
    if ($description && !$isFullWidth) {
        $tabs[] = ['label' => __('Details'), 'html' => '<div class="prose prose-sm max-w-none text-secondary">' . $description . '</div>'];
    }
    // trim(): a block without attributes still prints whitespace, which showed an empty tab
    $attributesHtml = trim((string) $block->getChildHtml(
        $isFullWidth ? 'product.attributes.non_pagebuilder' : 'product.attributes'
    ));
    if ($attributesHtml) {
        $tabs[] = ['label' => __('Additional Information'), 'html' => $attributesHtml];
    }
    $reviewsHtml = trim((string) $block->getChildHtml('reviews.tab'));
    if ($reviewsHtml) {
        $tabs[] = ['label' => __('Reviews'), 'html' => $reviewsHtml];
    }
    ?>
    <hyperion-tabs class="block border-t border-subtle pt-8">
        <?php /* Skeleton of the tab strip the component renders (same text, padding and rule as its
                 shadow buttons): until the chunk arrives `_components.css` shows this strip and the
                 first panel only, with the panel's padding, so the section has its final height from
                 the first paint; once defined the strip is hidden (no layout shift). */ ?>
        <div class="flex flex-wrap border-b border-subtle" data-hyperion-tabs-skeleton aria-hidden="true">
            <?php foreach ($tabs as $tab): ?>
                <span class="-mb-px whitespace-nowrap border-b-2 border-transparent px-4 py-3 text-transparent"><?= $escaper->escapeHtml($tab['label']) ?></span>
            <?php endforeach; ?>
        </div>
        <?php foreach ($tabs as $tab): ?>
            <hyperion-tab label="<?= $escaper->escapeHtmlAttr($tab['label']) ?>">
                <?= /* @noEscape */ $tab['html'] ?>
            </hyperion-tab>
        <?php endforeach; ?>
    </hyperion-tabs>

    <?php /* -- Related / Upsell carousels ----------------------
        Fetch by block name rather than child alias -- Magento's native
        layout attaches these blocks to `content.aside`, and our layout-
        XML `<move>` doesn't reliably re-parent them into the PDP
        getChildHtml pool under every merge ordering. `getLayout()
        ->getBlock('catalog.product.related')` walks the block graph by
        registered name and returns the resolved instance whatever its
        current parent is. */ ?>
    <?= $block->getChildHtml('catalog.product.related') ?>
    <?= $block->getChildHtml('product.info.upsell') ?>
    <?php if ($isFullWidth): ?></div><?php endif; ?>

</section>
