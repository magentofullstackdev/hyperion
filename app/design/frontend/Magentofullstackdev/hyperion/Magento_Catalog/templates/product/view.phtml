                      hx-post="<?= $escaper->escapeUrl($block->getUrl('catalog/product_compare/add')) ?>"
                      hx-target="#hyperion-notification"
                      hx-swap="outerHTML"
                      hx-select="#hyperion-notification">
                    <?= $block->getBlockHtml('formkey') ?>
                    <input type="hidden" name="product" value="<?= (int) $productId ?>">
                    <button type="submit"
                            title="<?= $escaper->escapeHtmlAttr(__('Add to Compare')) ?>"
