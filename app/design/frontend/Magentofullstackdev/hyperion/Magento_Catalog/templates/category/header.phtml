/**
 * Hyperion category header -- title, image, description, CMS block, and
 * subcategory-grid fallback for "Static block only" categories with no block.
 *
 * Magento\Catalog\Block\Category\View exposes:
 *   getCurrentCategory(), getCategoryDescription(), getImage(), getCmsBlockHtml(),
 *   isProductMode(), isMixedMode(), isContentMode()
 *
 * @var \Magento\Catalog\Block\Category\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
$category = $block->getCurrentCategory();
$imageUrl = $category?->getImageUrl();
$description = $category ? $block->getCategoryDescription() : '';
$cmsBlockHtml = (string) $block->getCmsBlockHtml();
$isContentMode = $block->isContentMode();
$isMixedMode = $block->isMixedMode();
$showSubcategoryFallback = $isContentMode && !$isMixedMode && $cmsBlockHtml === '';

$children = [];
if ($showSubcategoryFallback && $category) {
    foreach ($category->getChildrenCategories() as $child) {
        if ($child->getIsActive() && $child->getIncludeInMenu()) {
            $children[] = $child;
        }
    }
}
?>
<div class="mb-8 space-y-6">
    <?php if ($imageUrl): ?>
        <div class="rounded-2xl overflow-hidden bg-surface-raised">
            <img src="<?= $escaper->escapeUrl($imageUrl) ?>"
                 alt="<?= $escaper->escapeHtmlAttr($category->getName()) ?>"
                 class="w-full h-auto object-cover"
                 loading="lazy"/>
        </div>
    <?php endif; ?>

    <div>
        <h1 class="text-3xl font-bold text-secondary tracking-tight">
            <?= $escaper->escapeHtml($category->getName()) ?>
        </h1>
        <?php if ($description): ?>
            <div class="mt-2 text-secondary max-w-3xl prose prose-sm">
                <?= /* @noEscape */ $description ?>
            </div>
        <?php endif; ?>
    </div>

    <?php if ($cmsBlockHtml !== ''): ?>
        <div class="category-cms-block">
            <?= /* @noEscape */ $cmsBlockHtml ?>
        </div>
    <?php endif; ?>

    <?php if ($showSubcategoryFallback && !empty($children)): ?>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 pt-2">
            <?php foreach ($children as $child): ?>
                <?php $childImage = $child->getImageUrl(); ?>
                <a href="<?= $escaper->escapeUrl($child->getUrl()) ?>"
                   class="group block bg-surface rounded-xl border border-subtle overflow-hidden hover:shadow-lg hover:border-primary/30 transition-all duration-200">
                    <div class="aspect-square bg-surface-raised overflow-hidden">
                        <?php if ($childImage): ?>
                            <img src="<?= $escaper->escapeUrl($childImage) ?>"
                                 alt="<?= $escaper->escapeHtmlAttr($child->getName()) ?>"
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                 loading="lazy"/>
                        <?php else: ?>
                            <div class="w-full h-full flex items-center justify-center text-muted">
                                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                            </div>
                        <?php endif; ?>
                    </div>
                    <div class="p-4 text-center">
                        <h2 class="text-sm font-medium text-secondary group-hover:text-primary transition-colors">
                            <?= $escaper->escapeHtml($child->getName()) ?>
                        </h2>
                    </div>
                </a>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>
