/**
 * Hyperion order success page.
 *
 * @var \Magento\Checkout\Block\Onepage\Success $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magentofullstackdev\HyperionCore\Model\ViewModelRegistry $viewModels
 */
// GA4 `purchase` (plus the Google Ads conversion <hyperion-gtag> derives from it).
$purchaseJson = $viewModels->require(\Magentofullstackdev\HyperionCheckout\ViewModel\GtagCheckout::class)->getPurchaseJson();
?>
<?php if ($purchaseJson !== ''): ?>
<span data-hyperion-gtag-event="purchase" data-hyperion-gtag-payload="<?= $escaper->escapeHtmlAttr($purchaseJson) ?>" hidden></span>
<?php endif; ?>
<div class="max-w-lg mx-auto py-12 text-center">
    <div class="bg-surface rounded-2xl border border-subtle shadow-sm p-8 space-y-6">
        <div class="w-16 h-16 mx-auto rounded-full bg-success-subtle flex items-center justify-center">
            <svg class="w-8 h-8 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
        </div>

        <div class="space-y-2">
            <h1 class="text-2xl font-bold text-secondary tracking-tight">
                <?= $escaper->escapeHtml(__('Thank you for your purchase!')) ?>
            </h1>
            <?php if ($block->getOrderId()): ?>
                <p class="text-muted">
                    <?= $escaper->escapeHtml(__('Your order number is:')) ?>
                    <?php if ($block->getCanViewOrder()): ?>
                        <a href="<?= $escaper->escapeUrl($block->getViewOrderUrl()) ?>"
                           class="font-mono font-bold text-primary hover:text-primary-hover hover:underline ml-1">
                            #<?= $escaper->escapeHtml($block->getOrderId()) ?>
                        </a>
                    <?php else: ?>
                        <span class="font-mono font-bold text-secondary ml-1">#<?= $escaper->escapeHtml($block->getOrderId()) ?></span>
                    <?php endif; ?>
                </p>
                <p class="text-sm text-muted">
                    <?= $escaper->escapeHtml(__('We\'ll email you an order confirmation with details and tracking info.')) ?>
                </p>
            <?php endif; ?>
        </div>

        <?= $block->getAdditionalInfoHtml() ?>
        <?php /* Downloadable products: core's "Go to My Downloadable Products" sentence (a child of this block). */ ?>
        <?php $downloadableHtml = trim((string) $block->getChildHtml('downloadable.checkout.success')); ?>
        <?php if ($downloadableHtml !== ''): ?>
            <p class="text-sm text-secondary [&_a]:font-semibold [&_a]:text-primary [&_a]:underline"><?= /* @noEscape -- a rendered child block */ $downloadableHtml ?></p>
        <?php endif; ?>

        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-subtle">
            <?php if ($block->getCanViewOrder()): ?>
                <a href="<?= $escaper->escapeUrl($block->getViewOrderUrl()) ?>"
                   class="flex-1 text-center py-3 px-6 text-sm font-medium text-secondary bg-surface border border-subtle rounded-lg hover:bg-surface-raised transition-colors">
                    <?= $escaper->escapeHtml(__('View Order')) ?>
                </a>
            <?php endif; ?>
            <a href="<?= $escaper->escapeUrl($block->getContinueUrl()) ?>"
               class="flex-1 py-3 px-6 bg-primary text-white font-bold rounded-lg hover:bg-primary-hover transition-colors shadow-md hover:shadow-lg text-sm text-center uppercase tracking-wider">
                <?= $escaper->escapeHtml(__('Continue Shopping')) ?>
            </a>
        </div>
    </div>
    <?php /* Guest "Create an Account" offer: core's checkout.registration block (moved here by the theme layout), '' unless it applies. */ ?>
    <?= $block->getChildHtml('checkout.registration') ?>
</div>
