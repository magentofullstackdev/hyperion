<!--
    PayPal on the cart page: core blocks the Hyperion cart has no use for.
    The smart buttons are the `paypal_express` entry of the express button
    pool, the Pay Later message and the cart total are added in
    hyperion_cart_extensions.xml (the page and its htmx fragment).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.cart.braintree.credit" remove="true"/>
        <referenceBlock name="paylater.right.logo" remove="true"/>
    </body>
</page>
