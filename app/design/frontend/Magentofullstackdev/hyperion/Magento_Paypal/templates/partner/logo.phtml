declare(strict_types=1);

/**
 * PayPal acceptance logo (sidebar of the home and category pages). Core
 * opens the "What is PayPal" page through an inline script; here it is a
 * plain link.
 *
 * @var \Magento\Paypal\Block\Logo $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<div class="mb-6">
    <a href="<?= $escaper->escapeUrl($block->getAboutPaypalPageUrl()) ?>"
       target="_blank"
       rel="noopener noreferrer"
       title="<?= $escaper->escapeHtmlAttr(__('Additional Options')) ?>"
       class="inline-block rounded focus:outline-none focus:ring-2 focus:ring-primary">
        <img src="<?= $escaper->escapeUrl($block->getLogoImageUrl()) ?>"
             alt="<?= $escaper->escapeHtmlAttr(__('Additional Options')) ?>"
             loading="lazy">
    </a>
</div>
