{
    "name": "magentofullstackdev/theme-hyperion",
    "description": "Hyperion default frontend theme: stateless, edge-cacheable Magento 2 storefront. Ships the JS/CSS bundle built from the frontend/ workspace of the repository (web/manifest.json + web/assets/).",
    "type": "magento2-theme",
    "license": "MIT",
    "version": "0.9.0-beta.5",
    "homepage": "https://hyperionfront.dev",
    "authors": [
        {
            "name": "Sergiu Ro",
            "email": "sergiu.ro@magentofullstack.dev",
            "homepage": "https://magentofullstack.dev",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/magentofullstackdev/hyperion/issues",
        "source": "https://github.com/magentofullstackdev/hyperion"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "magento/framework": "^103.0.8",
        "magentofullstackdev/module-hyperion-catalog": "self.version",
        "magentofullstackdev/module-hyperion-catalog-mode": "self.version",
        "magentofullstackdev/module-hyperion-checkout": "self.version",
        "magentofullstackdev/module-hyperion-cms": "self.version",
        "magentofullstackdev/module-hyperion-core": "self.version",
        "magentofullstackdev/module-hyperion-customer": "self.version",
        "magentofullstackdev/module-hyperion-image": "self.version",
        "magentofullstackdev/module-hyperion-navigation": "self.version",
        "magentofullstackdev/module-hyperion-mega-menu": "self.version",
        "magentofullstackdev/module-hyperion-search": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ]
    }
}
