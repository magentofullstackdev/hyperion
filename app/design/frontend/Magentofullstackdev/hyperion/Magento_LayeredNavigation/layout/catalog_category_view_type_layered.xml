<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!--
            Native Magento layered navigation mounts `catalog.leftnav` into
            `sidebar.main`. We only swap the templates so the rendered markup
            matches Hyperion's Tailwind system; we do not move the block or
            discard the sidebar.main container - that responsibility lives
            with Magento's page_layout handle (default: 2columns-left for
            layered category pages).
        -->
        <referenceBlock name="catalog.leftnav"
                        template="Magento_LayeredNavigation::layer/view.phtml"/>
        <referenceBlock name="catalog.navigation.renderer"
                        template="Magento_LayeredNavigation::layer/filter.phtml"/>
    </body>
</page>
