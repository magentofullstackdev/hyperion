declare(strict_types=1);
/**
 * Hyperion "Share Wish List" form: plain POST to `wishlist/index/send`.
 *
 * The `captcha` child is the reCAPTCHA block Magento_ReCaptchaWishlist adds
 * when the wishlist form is protected; it renders <hyperion-recaptcha>.
 * getEnteredData() returns escaped values (refill after a failed send).
 *
 * @var \Magento\Wishlist\Block\Customer\Sharing $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Magento\Wishlist\Block\Rss\Link|false $rssLink */
$rssLink = $block->getChildBlock('rss_link');
?>
<article class="bg-surface border border-subtle rounded-xl p-6 space-y-6">

    <h2 class="text-lg font-semibold text-secondary">
        <?= $escaper->escapeHtml(__('Sharing Information')) ?>
    </h2>

    <form action="<?= $escaper->escapeUrl($block->getSendUrl()) ?>"
          method="post"
          id="form-validate"
          class="space-y-5">
        <?= $block->getBlockHtml('formkey') ?>

        <div>
            <label for="email_address" class="block text-sm font-medium text-secondary mb-1">
                <?= $escaper->escapeHtml(__('Email addresses, separated by commas')) ?>
                <span aria-hidden="true" class="text-error">*</span>
            </label>
            <textarea name="emails"
                      id="email_address"
                      rows="3"
                      required
                      autocomplete="off"
                      class="w-full px-4 py-2.5 border border-subtle rounded-lg bg-surface text-secondary text-sm resize-y
                             focus:ring-2 focus:ring-primary focus:border-primary outline-none"
                ><?= /* @noEscape */ $block->getEnteredData('emails') ?></textarea>
        </div>

        <div>
            <label for="message" class="block text-sm font-medium text-secondary mb-1">
                <?= $escaper->escapeHtml(__('Message')) ?>
            </label>
            <textarea name="message"
                      id="message"
                      rows="5"
                      class="w-full px-4 py-2.5 border border-subtle rounded-lg bg-surface text-secondary text-sm resize-y
                             focus:ring-2 focus:ring-primary focus:border-primary outline-none"
                ><?= /* @noEscape */ $block->getEnteredData('message') ?></textarea>
        </div>

        <?php if ($rssLink && $rssLink->isRssAllowed()): ?>
            <label class="flex items-start gap-3 text-sm text-secondary cursor-pointer" for="rss_url">
                <input type="checkbox"
                       name="rss_url"
                       id="rss_url"
                       value="1"
                       class="mt-0.5 h-4 w-4 rounded border-subtle text-primary focus:ring-2 focus:ring-primary">
                <?= $escaper->escapeHtml(__('Check here to link an RSS feed to your Wish List.')) ?>
            </label>
        <?php endif; ?>

        <?= $block->getChildHtml('captcha') ?>

        <div class="flex items-center justify-end gap-4 pt-4 border-t border-subtle">
            <a href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>"
               class="text-sm font-medium text-primary hover:text-primary-hover underline-offset-2 hover:underline">
                <?= $escaper->escapeHtml(__('Back')) ?>
            </a>
            <button type="submit"
                    class="inline-flex items-center justify-center px-6 py-2.5
                           rounded-lg font-semibold text-sm
                           bg-primary text-on-primary shadow-sm
                           hover:bg-primary-hover hover:shadow-md
                           focus:outline-none focus:ring-2 focus:ring-primary">
                <?= $escaper->escapeHtml(__('Share Wish List')) ?>
            </button>
        </div>
    </form>
</article>
