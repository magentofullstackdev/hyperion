/**
 * Hyperion product alert link -- stock or price alert. No KO/RequireJS.
 *
 * Uses the block's setSignupLabel / setHtmlClass / getSignupUrl methods
 * from Magento\ProductAlert\Block\Product\View\Stock and \View\Price.
 *
 * @var \Magento\ProductAlert\Block\Product\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

use Magento\ProductAlert\Block\Product\View as ProductAlertView;
use Magento\Framework\Escaper;

/** @var ProductAlertView $block */
/** @var Escaper $escaper */

$signupUrl = $block->getSignupUrl();
$signupLabel = $block->getSignupLabel() ?: __('Notify me');
$htmlClass = $block->getHtmlClass();

if (!$signupUrl) {
    return;
}
?>
<div class="product-alert <?= $escaper->escapeHtmlAttr((string) $htmlClass) ?> mt-3">
    <a href="<?= $escaper->escapeUrl((string) $signupUrl) ?>"
       class="inline-flex items-center gap-2 text-sm text-primary hover:text-primary-hover underline underline-offset-2 transition-colors"
       title="<?= $escaper->escapeHtmlAttr((string) $signupLabel) ?>">
        <svg class="w-4 h-4 shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        <span><?= $escaper->escapeHtml((string) $signupLabel) ?></span>
    </a>
</div>
