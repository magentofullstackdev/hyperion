<!--
    Sign in page: the login container (social login buttons and the like).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="customer.login.container">
            <block class="Magento\Framework\View\Element\Template" name="hyperion.sample.marker.login"
                   template="Magentofullstackdev_HyperionSampleExtension::marker.phtml">
                <arguments>
                    <argument name="marker" xsi:type="string">customer.login.container</argument>
                    <argument name="markers" xsi:type="object">Magentofullstackdev\HyperionSampleExtension\ViewModel\Markers</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
