<!--
    Magentofullstackdev_HyperionSampleExtension

    A module that extends a Hyperion store the way a third party does,
    through the public surface only:

      - a fake pickup locker carrier (hyperionlocker) with its checkout
        picker, registered on the shipping extension pool, and its server
        half (extension attribute, validation plugin, quote and order
        address column);
      - a generic checkout extension: a slot element, a request filter, a
        gate and an address field;
      - a cart total and its row renderer;
      - marker blocks in every storefront container, a header and a footer
        link, and observers of the two Hyperion events.

    Everything is inert until hyperion_sample_extension/general/enabled is 1
    (and the carrier, marker and fee flags for their parts). Development and
    test aid: it lives under dev/modules/, is never part of a release
    archive and never published as a Composer package.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Magentofullstackdev_HyperionSampleExtension">
        <sequence>
            <module name="Magento_Store"/>
            <module name="Magento_Catalog"/>
            <module name="Magento_Customer"/>
            <module name="Magento_Quote"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Shipping"/>
            <module name="Magento_Checkout"/>
            <module name="Magentofullstackdev_HyperionCore"/>
            <module name="Magentofullstackdev_HyperionCheckout"/>
        </sequence>
    </module>
</config>
