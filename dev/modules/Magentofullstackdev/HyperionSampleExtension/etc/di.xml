<!--
    Server half of the locker picker. Global: the shipping information is
    saved and the order placed through REST (webapi_rest area). It touches
    no Hyperion pool.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Model\ShippingInformationManagement">
        <plugin name="hyperion_sample_locker_point"
                type="Magentofullstackdev\HyperionSampleExtension\Plugin\ShippingInformationManagementPlugin"/>
    </type>
    <type name="Magento\Quote\Model\Quote\Address\ToOrderAddress">
        <plugin name="hyperion_sample_locker_point_to_order"
                type="Magentofullstackdev\HyperionSampleExtension\Plugin\ToOrderAddressPlugin"/>
    </type>
</config>
