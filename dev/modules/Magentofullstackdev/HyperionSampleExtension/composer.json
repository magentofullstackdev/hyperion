{
    "name": "magentofullstackdev/module-hyperion-sample-extension",
    "description": "Hyperion Sample Extension - a fake pickup locker carrier with its checkout picker, a generic checkout extension (slot, request filter, gate, address field), a cart total and marker blocks in every storefront extension point. Shows how a module extends Hyperion through its public pools and containers. Development and test aid, never published.",
    "type": "magento2-module",
    "license": "MIT",
    "version": "0.9.0-beta.7",
    "homepage": "https://hyperionfront.dev",
    "authors": [
        {
            "name": "Sergiu Ro",
            "email": "sergiu.ro@magentofullstack.dev",
            "homepage": "https://magentofullstack.dev",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/magentofullstackdev/hyperion/issues",
        "source": "https://github.com/magentofullstackdev/hyperion"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "magento/framework": "^103.0.8",
        "magento/module-catalog": "*",
        "magento/module-checkout": "*",
        "magento/module-customer": "*",
        "magento/module-quote": "*",
        "magento/module-sales": "*",
        "magento/module-shipping": "*",
        "magento/module-store": "*",
        "magentofullstackdev/module-hyperion-core": "self.version",
        "magentofullstackdev/module-hyperion-checkout": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magentofullstackdev\\HyperionSampleExtension\\": ""
        }
    }
}
