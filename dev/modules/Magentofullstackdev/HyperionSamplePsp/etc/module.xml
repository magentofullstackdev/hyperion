<!--
    Magentofullstackdev_HyperionSamplePsp

    A fake payment service provider written the way a third party writes
    one for the Hyperion checkout: every storefront part is registered
    through the public pools of Magentofullstackdev_HyperionCheckout in
    etc/frontend/di.xml, every browser part is a plain ES module under
    view/frontend/web/js/hyperion/ that defines a custom element. Nothing
    here imports Lit, signals, Tailwind or a Hyperion bundle.

    Methods: hyperion_sample_card (hosted field, fake 3D Secure, saved
    cards through hyperion_sample_card_vault), hyperion_sample_redirect
    (hosted page after the order), hyperion_sample_form (declarative
    field) and an express button. Everything is inert until
    hyperion_sample/general/enabled and the method's own active flag are 1.

    Development and test aid: it lives under dev/modules/, is never part of
    a release archive and never published as a Composer package.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Magentofullstackdev_HyperionSamplePsp">
        <sequence>
            <module name="Magento_Store"/>
            <module name="Magento_Catalog"/>
            <module name="Magento_Customer"/>
            <module name="Magento_Quote"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Payment"/>
            <module name="Magento_Vault"/>
            <module name="Magento_Checkout"/>
            <module name="Magentofullstackdev_HyperionCore"/>
            <module name="Magentofullstackdev_HyperionCheckout"/>
        </sequence>
    </module>
</config>
