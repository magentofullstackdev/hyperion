<!--
    /hyperionsample/: the fake gateway pages (hosted field, 3D Secure
    challenge, hosted payment page, express start and return). The sample
    extension module adds its own controllers to the same route.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/routes.xsd">
    <router id="standard">
        <route id="hyperionsample" frontName="hyperionsample">
            <module name="Magentofullstackdev_HyperionSamplePsp"/>
        </route>
    </router>
</config>
