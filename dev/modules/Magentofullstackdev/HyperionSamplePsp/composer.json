{
    "name": "magentofullstackdev/module-hyperion-sample-psp",
    "description": "Hyperion Sample PSP - a fake payment service provider (card with hosted field, 3D Secure and vault, hosted page redirect, declarative form, express button) that shows how a payment module plugs into the Hyperion checkout through its public pools. Development and test aid, never published.",
    "type": "magento2-module",
    "license": "MIT",
    "version": "0.9.0-beta.7",
    "homepage": "https://hyperionfront.dev",
    "authors": [
        {
            "name": "Sergiu Ro",
            "email": "sergiu.ro@magentofullstack.dev",
            "homepage": "https://magentofullstack.dev",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/magentofullstackdev/hyperion/issues",
        "source": "https://github.com/magentofullstackdev/hyperion"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "magento/framework": "^103.0.8",
        "magento/module-catalog": "*",
        "magento/module-checkout": "*",
        "magento/module-customer": "*",
        "magento/module-payment": "*",
        "magento/module-quote": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*",
        "magento/module-vault": "*",
        "magentofullstackdev/module-hyperion-checkout": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magentofullstackdev\\HyperionSamplePsp\\": ""
        }
    }
}
